---
// src/layouts/DocsLayout.astro
import Layout from "./Layout.astro";
import Header from "@components/Header.astro"; 
import PageFrame from "@/components/PageFrame.astro";
import MobileDocsNav from "@docs/mobile/MobileDocsNav.astro";
import ScrollToTop from "@docs/mobile/ScrollToTop.astro";
import LeftSidebar from "@/components/docs/LeftSidebar.astro";

import { type buildMeta as BuildMetaFn } from "@/consts";

interface Props {
  meta?: Partial<ReturnType<typeof BuildMetaFn>>;
  schema?: object | object[];
  isHome?: boolean;
  canonical?: string;
  author?: string;
  publisher?: string;
}

const { 
  meta, 
  schema, 
  isHome = false, 
  canonical,
  author,
  publisher,
} = Astro.props;
---
<Layout 
  hideHeader 
  hideFooter
  {meta} 
  {schema} 
  {isHome} 
  {canonical}
  {author}
  {publisher}
>
  <Header>
    <MobileDocsNav />
  </Header>
  <PageFrame>
    <LeftSidebar />
    <main id="docs-content" class="w-full min-w-0 flex-1">
      <slot />
    </main>
    <aside 
      aria-label="Table of Contents"
      class="hidden lg:block sticky top-0 h-screen w-full overflow-y-auto px-4 py-4 border-l border-(--border) scrollbar-gutter-stable"
    >
      <slot name="right" />
    </aside>
  </PageFrame>
  <ScrollToTop />
</Layout>
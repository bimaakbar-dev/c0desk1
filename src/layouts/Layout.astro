---
// src/layouts/Layout.astro
import { 
  SITE, 
  type buildMeta as BuildMetaFn 
} from "@/consts";

import Head from "@components/Head.astro";
import ThemeProvider from "@components/ThemeProvider.astro";
import SkipLink from "@components/SkipLink.astro";
import Search from "@components/Search.astro";
import Page from "@/components/Page.astro";
import Header from "@components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  meta?: Partial<ReturnType<typeof BuildMetaFn>>;
  schema?: object | object[];
  isHome?: boolean;
  canonical?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  author?: string;
  publisher?: string;
  next?: string;
  prev?: string;
}

const {
  meta,
  schema,
  isHome = false,
  canonical,
  hideHeader = false,
  hideFooter = false,
  author,
  publisher,
  next,
  prev,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} dir={SITE.dir}>
  <Head {meta} {schema} {isHome} {canonical} {author} {publisher} {next} {prev}>
    <ThemeProvider />
  </Head>
  <body class:list={isHome ? 'home ' : ''}>
    <SkipLink />
    <Search />
    <Page>
      {!hideHeader && <Header />}
      <slot />
      {!hideFooter && <Footer />}
    </Page>
  </body>
</html>

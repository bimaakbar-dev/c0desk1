---
// src/components/mdx/Quote.astro

interface Props {
  user?: string;
  avatar?: string;
  role?: string;
  url?: string;
}

const { user, avatar, role, url } = Astro.props;
---

<figure class="quote">
  <blockquote class="quote-body">
    <slot />
  </blockquote>
  {
    user && (
      <figcaption class="quote-footer">
        <User avatar={avatar} role={role} url={url}>
          {user}
        </User>
      </figcaption>
    )
  }
</figure>

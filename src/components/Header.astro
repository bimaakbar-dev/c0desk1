---
// src/components/Header.astro
import Container from "./ui/Container.astro";
import Theme from "./Theme.astro";
import Logo from "./ui/Logo.astro";
import SearchBar from "./ui/SearchBar.astro";
import NavLink from "./NavLink.astro";
import Mobile from "./MobileNav.astro";
---

<header id="main-header">
  <Container size="full" class="h-full">
    <div class="header-wrapper">
      <div class="header-left">
        <Logo />
        <NavLink />
      </div>

      <div class="header-right">
        <div class="desktop-search">
          <SearchBar class="search-min" />
        </div>
        <div class="mobile-search">
          <SearchBar iconOnly />
        </div>
        <div class="desktop-theme">
          <Theme />
        </div>
        {Astro.slots.has("default") ? <slot /> : <Mobile />}
      </div>
    </div>
  </Container>
</header>

<style>
  #main-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    padding-top: var(--safe-top);
    height: var(--header-height);
    background-color: transparent;
    border-bottom: 1px solid var(--border-subtle);
    transition: box-shadow var(--duration-md) var(--ease-out);
  }

  #main-header.scrolled {
    background-color: var(--bg);
    box-shadow: var(--shadow-sm);
  }

  /* --- LAYOUT WRAPPER & GRID --- */
  .header-wrapper {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    height: 100%;
    margin-inline: auto;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* --- RESPONSIF --- */
  .desktop-search,
  .desktop-theme {
    display: none;
  }

  .mobile-search {
    display: flex;
  }

  @media (min-width: 768px) {
    .desktop-search,
    .desktop-theme {
      display: flex;
    }
    .mobile-search {
      display: none;
    }
  }

  .search-min {
    min-width: 14rem;
  }
</style>

<script is:inline>
  (() => {
    const header = document.getElementById("main-header");
    if (!header) return;

    const toggleHeader = () => {
      const isScrolled = window.scrollY > 10;
      header.classList.toggle("scrolled", isScrolled);
    };

    window.addEventListener("scroll", toggleHeader, { passive: true });
    toggleHeader();
  })();
</script>

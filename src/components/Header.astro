---
// src/components/Header.astro
import Container from "./ui/Container.astro";
import Mobile from "./MobileNav.astro";
import Theme from "./Theme.astro";
import Logo from "./ui/Logo.astro";
import SearchBar from "./ui/SearchBar.astro";
import NavLink from "./NavLink.astro";

const styles = {
  header: [
    "sticky top-0 z-50 w-full h-full pt-(--safe-top)",
    "bg-none border-b lg:border-b-none border-(--border-subtle)",
    "transition-opacity duration-(--duration-fast) ease-(--ease-out)"
  ].join(" "),
  wrapper: [
    "grid grid-cols-[1fr_auto] items-center h-(--header-height) mx-auto",
    "gap-4"
  ].join(" "),

  left: "flex items-center gap-4",
  right: "flex items-center gap-2"
};
---

<header id="main-header" class={styles.header}>
  <Container size="full">
    <div class={styles.wrapper}>
      <div class={styles.left}>
        <Logo />
        <NavLink />
      </div>
      <div class={styles.right}>
        <div class="flex md:hidden">
          <SearchBar iconOnly />
        </div>
        <div class="hidden md:flex">
          <SearchBar class="min-w-64" />
        </div>
        <div class="hidden md:flex">
          <Theme />
        </div>
        <Mobile />
      </div>
    </div>
  </Container>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById("main-header");
    if (!header) return;

    const toggleHeader = () => {
      const isScrolled = window.scrollY > 10;
      header.classList.toggle("bg-(--bg)", isScrolled);
      header.classList.toggle("lg:border-(--border-subtle)", isScrolled);
      header.classList.toggle("shadow-(--shadow-sm)", isScrolled);
      header.classList.toggle("bg-none", !isScrolled);
      header.classList.toggle("lg:border-none", !isScrolled);
    };

    window.addEventListener("scroll", toggleHeader, { passive: true });
    toggleHeader();
  })();
</script>

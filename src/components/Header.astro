---
// src/components/Header.astro
import Container from "./ui/Container.astro";
import Theme from "./Theme.astro";
import Logo from "./ui/Logo.astro";
import SearchBar from "./ui/SearchBar.astro";
import NavLink from "./NavLink.astro";
import Mobile from "./MobileNav.astro";

const styles = {
  header: [
    "sticky top-0 z-50 w-full pt-(--safe-top)",
    "h-(--header-height)",
    "bg-transparent border-b border-transparent"
  ].join(" "),
  wrapper: [
    "grid grid-cols-[1fr_auto] items-center h-full mx-auto",
    "gap-4"
  ].join(" "),

  left: "flex items-center gap-4",
  right: "flex items-center gap-2"
};
---

<header id="main-header" class={styles.header}>
  <Container size="full" class="h-full">
    <div class={styles.wrapper}>
      <div class={styles.left}>
        <Logo />
        <NavLink />
      </div>

      <div class={styles.right}>
        <div class="hidden md:flex">
          <SearchBar class="min-w-56" />
        </div>
        <div class="flex md:hidden">
          <SearchBar iconOnly />
        </div>
        <div class="hidden md:flex">
          <Theme />
        </div>
        {Astro.slots.has('default') ? (
          <slot />
        ) : (
          <Mobile />
        )}
        
      </div>
    </div>
  </Container>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById("main-header");
    if (!header) return;

    const toggleHeader = () => {
      const isScrolled = window.scrollY > 10;
      header.classList.toggle("bg-(--bg)", isScrolled);
      header.classList.toggle("border-(--border)", isScrolled);
      header.classList.toggle("shadow-(--shadow-sm)", isScrolled);
      
      header.classList.toggle("bg-transparent", !isScrolled);
      header.classList.toggle("border-transparent", !isScrolled);
    };

    window.addEventListener("scroll", toggleHeader, { passive: true });
    toggleHeader();
  })();
</script>

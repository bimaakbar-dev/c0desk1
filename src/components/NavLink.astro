---
// src/components/Navbar.astro
import { NAV } from "@/config/navs";
import { canonicalUrl } from "@/lib/utils";

const currentPath = Astro.url.pathname;

const links = NAV.navBar.map((item) => {
  const isExternal = item.href.startsWith("http");
  const href = isExternal ? item.href : canonicalUrl(item.href);
  return {
    ...item,
    href,
    isExternal,
  };
});
---

<nav class="text-label-14 hidden items-center gap-6 font-medium md:flex">
  {
    links.map((item) => {
      const hrefPath = item.isExternal ? "" : new URL(item.href).pathname;
      const isActive = !item.isExternal && currentPath === hrefPath;

      return (
        <a
          href={item.href}
          class:list={[
            "transition-opacity",
            isActive
              ? "text-(--fg-strong)"
              : "text-(--fg-muted) hover:text-(--fg)",
          ]}
          target={item.isExternal ? "_blank" : undefined}
          rel={item.isExternal ? "noopener noreferrer" : undefined}
        >
          {item.label}
        </a>
      );
    })
  }
</nav>
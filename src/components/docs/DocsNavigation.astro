---
// src/components/docs/DocsNavigation.astro
import { getCollection } from 'astro:content';
import { 
  ROUTES, 
  SIDEBAR_CONFIG 
} from '@/consts';

import SidebarGroup from '@/components/ui/SidebarGroup.astro';
import SidebarLink from '@/components/ui/SidebarLink.astro';

const allDocs = await getCollection('docs', ({ data }) => !data.draft);

const categoryMap = new Map(
  SIDEBAR_CONFIG.map((c) => [c.category.toLowerCase(), c.label])
);
const validCategories = new Set(categoryMap.keys());

const docsByCategory = Object.groupBy(
  allDocs,
  (doc) => {
    const rawCategory = doc.data.category?.toLowerCase() ?? 'uncategorized';
    return validCategories.has(rawCategory) ? rawCategory : 'uncategorized';
  }
) as Partial<Record<string, typeof allDocs>>;

for (const category in docsByCategory) {
  docsByCategory[category]?.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
}

const sortedCategories = SIDEBAR_CONFIG
  .map(c => c.category.toLowerCase())
  .filter((cat) => cat !== 'uncategorized' && (docsByCategory[cat]?.length ?? 0) > 0);

const ungroupedDocs = docsByCategory['uncategorized'] ?? [];

const currentPath = Astro.url.pathname.endsWith('/') 
  ? Astro.url.pathname 
  : `${Astro.url.pathname}/`;

const baseDocsRoute = ROUTES.docs.endsWith('/') 
  ? ROUTES.docs 
  : `${ROUTES.docs}/`;

const getHref = (doc: (typeof allDocs)[number]) => {
  const rawSlug = doc.data.slug ?? doc.id.split('/').pop() ?? '';
  const cleanSlug = rawSlug.replace(/^\/+/, '').replace(/\/+$/, '');
  
  if (!cleanSlug) {
    return baseDocsRoute;
  }
  
  return `${baseDocsRoute}${cleanSlug}/`;
};

const checkIsActive = (href: string) => {
  return currentPath === href;
};

const $ = {
  wrapper: 'flex flex-col space-y-1 w-full flex-1 py-2 px-4',
};
---

<div class={$.wrapper}>
  {
    sortedCategories.map((categoryKey) => {
      const categoryDocs = docsByCategory[categoryKey] ?? [];
      const hasActiveChild = categoryDocs.some((doc) => checkIsActive(getHref(doc)));
      const label = categoryMap.get(categoryKey) ?? categoryKey;

      return (
        <SidebarGroup title={label} open={hasActiveChild}>
          {categoryDocs.map((doc) => (
            <SidebarLink href={getHref(doc)} isActive={checkIsActive(getHref(doc))}>
              {doc.data.title}
            </SidebarLink>
          ))}
        </SidebarGroup>
      );
    })
  }

  {
    ungroupedDocs.map((doc) => (
      <SidebarLink
        href={getHref(doc)}
        isActive={checkIsActive(getHref(doc))}
        grouped={false}
      >
        {doc.data.title}
      </SidebarLink>
    ))
  }
</div>

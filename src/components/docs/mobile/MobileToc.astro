---
// src/components/docs/mobile/MobileToc.astro
export interface Props {
  title?: string;
  headings: { 
    depth: number; 
    text: string; 
    slug: string
  }[];
}

const { 
  title = "On this page", 
  headings = [] 
} = Astro.props;

const filteredToc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const openLabel = title || "On this page";
---

<div class="mobile-toc-wrapper">
  {filteredToc.length > 0 && (
    <details id="m-toc-details" class="mobile-toc-details" data-page-title={title}>
      <summary class="mobile-toc-summary">
        <span class="mobile-toc-progress" role="progressbar" aria-label="Reading progress">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" focusable="false" fill="none" stroke-width="2" stroke="currentColor" stroke-linecap="butt">
            <circle cx="12" cy="12" r="11" opacity="0.5" class="progress-ring-bg" />
            <circle id="m-toc-progress-ring" cx="12" cy="12" r="11" stroke-dasharray="69.115" stroke-dashoffset="69.115" transform="rotate(-90 12 12)" class="progress-ring-fg" />
          </svg>
        </span>
        <span class="mobile-toc-label">
          <span id="m-toc-active-text" class="mobile-toc-title-active">{title}</span>
          <span class="mobile-toc-title-page">{openLabel}</span>
        </span>
        <span class="mobile-toc-icon">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </span>
      </summary>
      <nav class="mobile-toc-nav">
        <ul id="m-toc-list" class="mobile-toc-ul" role="list">
          {filteredToc.map((h) => {
            const isSub = h.depth === 3;
            return (
              <li class:list={[isSub && "mobile-toc-sub"]}>
                {isSub ? (
                  <div class="mobile-toc-item-h3">
                    <span class="mobile-toc-indicator" data-indicator />
                    <a
                      href={`#${h.slug}`}
                      data-toc-mobile-slug={h.slug}
                      data-depth={h.depth}
                      data-is-sub="true"
                      class="mobile-toc-link mobile-toc-link-h3"
                      aria-label={h.text}
                    >
                      {h.text}
                    </a>
                  </div>
                ) : (
                  <a
                    href={`#${h.slug}`}
                    data-toc-mobile-slug={h.slug}
                    data-depth={h.depth}
                    data-is-sub="false"
                    class="mobile-toc-link mobile-toc-link-h2"
                    aria-label={h.text}
                  >
                    {h.text}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </nav>
    </details>
  )}
</div>

<script>
  (function initMobileToc() {
    const tocLinks = document.querySelectorAll(
      "[data-toc-mobile-slug]"
    ) as NodeListOf<HTMLElement>;

    if (!tocLinks.length) return;

    const tocDetails = document.getElementById(
      "m-toc-details"
    ) as HTMLElement | null;
    const activeText = document.getElementById(
      "m-toc-active-text"
    ) as HTMLElement | null;
    const progressRing = document.getElementById(
      "m-toc-progress-ring"
    ) as HTMLElement | null;

    if (!tocDetails || !activeText || !progressRing) return;

    const pageTitle = tocDetails.dataset.pageTitle || "On this page";

    const linksArray = Array.from(tocLinks);
    const targets = linksArray
      .map((link) => document.getElementById(link.dataset.tocMobileSlug!))
      .filter((el): el is HTMLElement => el !== null);

    let active = "";
    const circumference = 69.115;

    const getTocSummaryHeight = () => {
      const summary = tocDetails.querySelector(".mobile-toc-summary") as HTMLElement | null;
      return summary ? summary.offsetHeight : 48;
    };

    const getHeaderHeight = () => {
      const root = document.documentElement;
      const header = getComputedStyle(root).getPropertyValue("--header-height").trim();
      const scrollPad = getComputedStyle(root).getPropertyValue("--scroll-padding").trim();
      const headerVal = parseInt(header) || 56;
      const padVal = parseInt(scrollPad) || 0;
      return headerVal + padVal;
    };

    const getScrollOffset = () => getHeaderHeight() + getTocSummaryHeight() + 48;

    const updateActiveLinks = () => {
      linksArray.forEach((link) => {
        const depth = parseInt(link.dataset.depth || "0");
        const isActive = link.dataset.tocMobileSlug === active;

        link.classList.remove("active-h2", "active-h3");

        if (isActive) {
          if (depth === 2) link.classList.add("active-h2");
          else if (depth === 3) link.classList.add("active-h3");
        }

        const parentDiv = link.closest(".mobile-toc-item-h3");
        if (parentDiv) {
          const indicator = parentDiv.querySelector(
            ".mobile-toc-indicator"
          ) as HTMLElement | null;
          if (indicator) {
            if (depth === 3 && isActive) {
              indicator.classList.add("indicator-active");
              indicator.classList.remove("indicator-inactive");
            } else {
              indicator.classList.remove("indicator-active");
              indicator.classList.add("indicator-inactive");
            }
          }
        }
      });
    };

    const updateRingProgress = () => {
      const scrollTop = window.scrollY;
      const docHeight =
        document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight <= 0 ? 0 : Math.min(scrollTop / docHeight, 1);
      progressRing.style.strokeDashoffset = String(
        circumference * (1 - progress)
      );
    };

    const updateSummaryText = () => {
      const label =
        window.scrollY < getHeaderHeight() && !active
          ? pageTitle
          : (active
              ? linksArray.find((l) => l.dataset.tocMobileSlug === active)
                  ?.textContent?.trim() || pageTitle
              : pageTitle);
      activeText.textContent = label;
    };

    document.querySelectorAll(".mobile-toc-indicator").forEach((el) => {
      el.classList.add("indicator-inactive");
      el.classList.remove("indicator-active");
    });

    updateRingProgress();
    updateSummaryText();
    updateActiveLinks();

    window.addEventListener(
      "scroll",
      () => {
        updateRingProgress();
        updateSummaryText();
      },
      { passive: true }
    );

    const getRootMargin = () => {
      const offset = getScrollOffset();
      return `-${offset}px 0px -65% 0px`;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntries = entries.filter((e) => e.isIntersecting);
        if (visibleEntries.length) {
          const topMostEntry = visibleEntries.reduce((a, b) =>
            a.boundingClientRect.top <= b.boundingClientRect.top ? a : b
          );
          active = (topMostEntry.target as HTMLElement).id;
        } else if (window.scrollY < getHeaderHeight()) {
          active = "";
        }
        updateSummaryText();
        updateActiveLinks();
      },
      { rootMargin: getRootMargin(), threshold: 0 }
    );

    targets.forEach((t) => observer.observe(t));

    const closeToc = () => tocDetails.removeAttribute("open");

    linksArray.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.dataset.tocMobileSlug;
        if (!targetId) return;

        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          const offset = getScrollOffset();
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.scrollY - offset;

          window.scrollTo({ top: offsetPosition });

          active = targetId;
          updateSummaryText();
          updateActiveLinks();
          closeToc();
        }
      });
    });

    const handleOutsideClick = (event: MouseEvent) => {
      if (
        tocDetails.hasAttribute("open") &&
        !tocDetails.contains(event.target as Node)
      )
        closeToc();
    };
    document.addEventListener("click", handleOutsideClick);
  })();
</script>

<style>
  .mobile-toc-wrapper {
    position: sticky;
    top: var(--header-height);
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  @media (min-width: 50rem) {
    .mobile-toc-wrapper {
      display: none;
    }
  }

  .mobile-toc-details {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    border-bottom: 1px solid var(--border-subtle);
    background-color: rgb(from var(--bg) r g b / 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .mobile-toc-details[open] .mobile-toc-nav {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-toc-summary {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 14px;
    font-weight: 500;
    color: var(--fg-strong);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.2s;
  }

  .mobile-toc-summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .mobile-toc-summary:hover {
      background-color: var(--bg-muted);
    }
  }

  .mobile-toc-progress {
    display: block;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    aspect-ratio: 1/1;
    color: var(--fg-muted);
  }

  .mobile-toc-progress svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .progress-ring-bg {
    opacity: 0.5;
  }

  .mobile-toc-details[open] .progress-ring-bg,
  .mobile-toc-details[open] .progress-ring-fg {
    color: var(--accent);
  }

  .progress-ring-fg {
    transition: stroke-dashoffset 0.2s;
  }

  .mobile-toc-label {
    position: relative;
    display: inline-flex;
    height: 100%;
    min-height: 1.375rem;
    flex: 1;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .mobile-toc-title-active,
  .mobile-toc-title-page {
    position: absolute;
    inset: 0;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    align-items: center;
    transition: transform 0.3s ease-out, opacity 0.3s ease-out;
  }

  .mobile-toc-title-active {
    transform: translateY(0);
    opacity: 1;
    color: var(--fg-muted);
  }

  .mobile-toc-details[open] .mobile-toc-title-active {
    transform: translateY(-100%);
    opacity: 0;
  }

  .mobile-toc-title-page {
    transform: translateY(100%);
    opacity: 0;
    color: var(--fg-strong);
  }

  .mobile-toc-details[open] .mobile-toc-title-page {
    transform: translateY(0);
    opacity: 1;
  }

  .mobile-toc-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    aspect-ratio: 1/1;
    color: var(--fg-muted);
    transition: transform 0.3s;
  }

  .mobile-toc-details[open] .mobile-toc-icon {
    transform: rotate(90deg);
  }

  .mobile-toc-nav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 40;
    max-height: 60vh;
    width: 100%;
    padding: 0.5rem 0.5rem 1rem;
    background-color: rgb(from var(--bg) r g b / 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
    transform-origin: top;
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.2s, border-color 0.2s;
    pointer-events: none;
  }

  .mobile-toc-details[open] .mobile-toc-nav {
    opacity: 1;
    pointer-events: auto;
    border-top-color: var(--border-subtle);
    border-bottom-color: var(--border-subtle);
  }

  .mobile-toc-ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 0;
  }

  .mobile-toc-sub {
    margin-left: 1rem;
  }

  .mobile-toc-item-h3 {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .mobile-toc-indicator {
    position: absolute;
    left: 0.75rem;
    top: 0;
    bottom: 0;
    width: 1px;
    transition: background-color 0.15s;
  }

  .mobile-toc-indicator.indicator-inactive {
    background-color: var(--border-subtle);
  }

  .mobile-toc-indicator.indicator-active {
    background-color: var(--accent);
    top: 10%;
    bottom: 10%;
    border-radius: var(--radius-full);
  }

  .mobile-toc-link {
    position: relative;
    display: block;
    width: 100%;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--fg-muted);
    transition: color 0.15s, background-color 0.15s;
    cursor: pointer;
  }

  @media (hover: hover) {
    .mobile-toc-link:hover {
      color: var(--fg-strong);
    }
  }

  .mobile-toc-link-h3 {
    padding-left: 1.5rem;
  }

  .mobile-toc-link.active-h2,
  .mobile-toc-link.active-h3 {
    background-color: rgb(from var(--bg-subtle) r g b / 0.8);
    color: var(--accent);
  }
</style>
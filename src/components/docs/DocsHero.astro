---
import { ROUTES } from "@/consts";

import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";

import Icon from "@ui/Icons.astro";
import Button from "@ui/Button.astro";
import Badge from "@ui/Badge.astro";

interface Props {
  title?: string;
  description?: string;
  badge?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  title = "Modern Documentation,<br/>Built for Developers",
  description = "A clean, fast, and customizable documentation template built with Astro, TailwindCSS. Start building in seconds.",
  badge = "",
  primaryText = "Get Started",
  primaryHref = `${ROUTES.docs}/getting-started/`,
  secondaryText = "Read Blog",
  secondaryHref = `${ROUTES.blog}/`,
} = Astro.props;

const $ = {
  section: [
    "relative py-16 lg:py-24",
    "bg-(--bg)",
  ].join(" "),
  
  backgroundPattern: [
    "absolute inset-0 z-0",
    "bg-[radial-gradient(var(--fg)_1px,transparent_1px)]",
    "[background-size:24px_24px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,#000_10%,transparent_100%)]",
    "opacity-60"
  ].join(" "),

  container: "relative z-10 mx-auto max-w-4xl text-center flex flex-col items-center",
  
  badge: [
    "gap-1.5 mb-5",
    "text-label-12 font-medium",
    badge ? "" : "hidden"
  ].join(" "),

  title: [
    "text-heading-40 md:text-heading-48 font-semibold text-(--fg-strong)",
    "tracking-tighter mb-5 leading-tight",
  ].join(" "),

  description: "text-body-18 text-(--fg-muted) mb-10 max-w-2xl",

  actions: "flex flex-wrap gap-4 items-center justify-center",
};
---

<Section class={$.section}>
  <div class={$.backgroundPattern} aria-hidden="true" />
  
  <Container size="lg" class={$.container}>

    {badge && (
      <Badge variant="accent" class={$.badge}>
        <Icon name="sparkle" class="size-3.5 text-(--accent)" />
        <span>{badge}</span>
      </Badge>
    )}

    <h1 class={$.title} set:html={title} />
    
    <p class={$.description}>{description}</p>

    <div class={$.actions}>
      <Button 
        href={primaryHref} 
        variant="primary" 
        size="lg" 
      >
        {primaryText}
      </Button>
      <Button 
        href={secondaryHref} 
        variant="outline" 
        size="lg"
        suffix={<Icon name="arrow-right" class="size-4" />}
      >
        {secondaryText}
      </Button>
    </div>

  </Container>
</Section>
---
// src/components/docs/LeftSidebar.astro
import SidebarMenu from "./SidebarMenu.astro";
import Socials from "@components/Socials.astro";
import Theme from "@components/Theme.astro";
import Card from "@ui/Card.astro";
import GithubStar from "@components/GithubStar.astro";
---

<div
  id="nav-overlay"
  class="fixed inset-0 z-30 hidden bg-(--bg-overlay) backdrop-blur-sm lg:hidden cursor-pointer opacity-0 transition-opacity duration-(--duration) ease-out"
  aria-hidden="true"
/>

<aside 
  id="left-sidebar" 
  class="fixed top-(--header-height) inset-x-0 z-45 w-full h-screen bg-(--bg) border-r border-(--border) hidden lg:block lg:sticky lg:z-0"
>
  <div class="flex flex-col h-full">
    <div class="flex-1 overflow-y-auto py-4 lg:py-2 scrollbar-gutter-stable">
      <SidebarMenu />
    </div>
    <div class="inline-flex shrink-0 p-4 justify-center mb-(--safe-bottom) lg:hidden border-t border-(--border-subtle)">
      <Card variant="primary" padding="xs" radius="sm">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1">
            <GithubStar repo="bimaakbar-dev/unloyd" />
            <Socials />
          </div>
          <Theme />
        </div>
      </Card>
    </div>
  </div>
</aside>

<style is:global>
  [data-nav-expanded] #left-sidebar {
    display: block;
    animation: slideIn var(--duration) var(--ease-out);
  }

  [data-nav-expanded] #nav-overlay {
    display: block;
    opacity: 1;
  }

  [data-nav-expanded] {
    overflow: hidden;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 50rem) {
    [data-nav-expanded] {
      overflow: auto;
    }
  }
</style>

<script>
  const overlay = document.getElementById('nav-overlay');
  if (overlay) {
    overlay.addEventListener('click', () => {
      document.body.removeAttribute('data-nav-expanded');
      const btn = document.querySelector('nav-toggle button');
      if (btn) {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open Menu');
      }
    });
  }
</script>
---
// src/components/docs/LeftSidebar.astro
import SidebarMenu from "./SidebarMenu.astro";
import Socials from "@components/Socials.astro";
import Theme from "@components/Theme.astro";
import Card from "@ui/Card.astro";
import GithubStar from "@components/GithubStar.astro";
---

<div
  id="nav-overlay"
  class="fixed inset-0 z-30 hidden cursor-pointer bg-(--bg-overlay) opacity-0 backdrop-blur-sm transition-opacity duration-(--duration) ease-out lg:hidden"
  aria-hidden="true"
>
</div>

<aside
  id="left-sidebar"
  class="fixed inset-x-0 top-(--header-height) pb-(--safe-bottom) z-45 hidden h-[calc(100vh-var(--header-height))] w-full border-r border-(--border) bg-(--bg) lg:sticky lg:z-0 lg:block"
>
  <div class="flex h-full flex-col">
    <div class="flex-1 scrollbar-gutter-stable overflow-y-auto py-4 lg:py-2">
      <SidebarMenu />
    </div>
    <div
      class="inline-flex justify-center border-t border-(--border) px-4 pt-2 lg:hidden "
    >
      <Card variant="primary" padding="xs" radius="sm">
        <div class="inline-flex items-center justify-between w-full">
          <div class="flex items-center gap-1 flex-1">
            <GithubStar repo="bimaakbar-dev/unloyd" />
            <Socials />
          </div>
          <Theme />
        </div>
      </Card>
    </div>
  </div>
</aside>

<style is:global>
  [data-nav-expanded] #left-sidebar {
    display: block;
    animation: slideIn var(--duration) var(--ease-out);
  }

  [data-nav-expanded] #nav-overlay {
    display: block;
    opacity: 1;
  }

  [data-nav-expanded] {
    overflow: hidden;
  }

  @keyframes slideIn {
    from {
      transform: translateY(-0.5rem);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (min-width: 50rem) {
    [data-nav-expanded] {
      overflow: auto;
    }
  }
</style>

<script>
  const overlay = document.getElementById("nav-overlay");
  if (overlay) {
    overlay.addEventListener("click", () => {
      document.body.removeAttribute("data-nav-expanded");
      const btn = document.querySelector("nav-toggle button");
      if (btn) {
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", "Open Menu");
      }
    });
  }
</script>

---
import { FORM_CONFIG } from "@/config/form";

import Input from "./Input.astro";
import Textarea from "./Textarea.astro";
import Button from "./Button.astro";
import Icon from "./Icons.astro";
import Spinner from "./Spinner.astro";
import Card from "./Card.astro";

const {
  endpoint,
  labels,
  placeholders,
  success,
  error,
  button,
  helper,
} = FORM_CONFIG;
---

<div id="contact-container">
  <div
    id="success-message"
    class="hidden bg-elevated border border-(--border) rounded-xl p-12 text-center animate-in fade-in zoom-in-95 duration-300 shadow-sm"
  >
    <div
      class="w-12 h-12 mx-auto mb-5 rounded-full bg-(--border) flex items-center justify-center text-strong"
    >
      <Icon name="check" class="size-5" />
    </div>
    <h3 class="text-body-16 font-semibold text-strong mb-2">
      {success.title}
    </h3>
    <p class="text-body-14 text-muted max-w-sm mx-auto">
      {success.description}
    </p>
  </div>

  <form id="contact-form" class="space-y-6" data-wmcp="contact">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <Input
        id="name"
        name="name"
        type="text"
        required
        label={labels.name}
        class="contact-input"
        placeholder={placeholders.name}
      />
      <Input
        id="email"
        name="email"
        type="email"
        label={labels.email}
        required
        class="contact-input"
        placeholder={placeholders.email}
      />
    </div>

    <Input
      id="subject"
      name="subject"
      type="text"
      label={labels.subject}
      required
      class="contact-input"
      placeholder={placeholders.subject}
    />

    <Textarea
      id="message"
      name="message"
      label={labels.message}
      required
      rows="4"
      class="contact-input"
      placeholder={placeholders.message}
      helper={helper}
    />

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
      <div class="flex items-center gap-2">
        <Icon name="info" fill class="size-4.5 text-(--info)" />
        <span class="text-label-14 text-(--fg-subtle)">
          {success.description}
        </span>
      </div>
      <Button
        id="submit-btn"
        type="submit"
        size="md"
        variant="primary"
        data-default-text={button.text}
        data-loading-text={button.loading}
      >
        <Spinner id="btn-spinner" size="sm" class="hidden" />
        <span id="btn-text">{button.text}</span>
      </Button>
    </div>

    <Card
      id="error-message"
      padding="sm"
      radius="sm"
      class="hidden mt-4 bg-(--color-error)/10 ring-(--error-soft)! text-(--color-error) text-label-13 text-center"
    >
      <div class="flex items-center gap-2">
        <Icon name="warning" fill class="size-4.5" />
        <span>{error.description}</span>
      </div>
    </Card>
  </form>
</div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const successMessage = document.getElementById("success-message");
  const errorMessage = document.getElementById("error-message");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const btnText = document.getElementById("btn-text") as HTMLElement | null;
  const btnSpinner = document.getElementById("btn-spinner") as HTMLElement | null;
  const formInputs = document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(".contact-input");

  const FORM_ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT || "";

  const defaultText = submitBtn?.dataset.defaultText || "Send Message";
  const loadingText = submitBtn?.dataset.loadingText || "Sending...";

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (errorMessage) errorMessage.classList.add("hidden");

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = loadingText;
      if (btnSpinner) btnSpinner.classList.remove("hidden");
      formInputs.forEach((input) => {
        (input as HTMLInputElement | HTMLTextAreaElement).disabled = true;
      });

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch(FORM_ENDPOINT, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.classList.add("hidden");
          if (successMessage) successMessage.classList.remove("hidden");
        } else {
          throw new Error("Failed to send");
        }
      } catch {
        if (errorMessage) errorMessage.classList.remove("hidden");
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = defaultText;
        if (btnSpinner) btnSpinner.classList.add("hidden");
        formInputs.forEach((input) => {
          (input as HTMLInputElement | HTMLTextAreaElement).disabled = false;
        });
      }
    });
  }
</script>
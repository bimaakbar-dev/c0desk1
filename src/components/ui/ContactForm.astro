---
import { FORM_CONFIG } from "@/config/form";

import Input from "./Input.astro";
import Textarea from "./Textarea.astro";
import Button from "./Button.astro";
import Icon from "./Icons.astro";
import Spinner from "./Spinner.astro";
import Card from "./Card.astro";

const { endpoint, labels, placeholders, success, error, button, helper } =
  FORM_CONFIG;
---

<div id="contact-container">
  <div
    id="success-message"
    class="bg-elevated animate-in fade-in zoom-in-95 hidden rounded-xl border border-(--border) p-12 text-center shadow-sm duration-300"
    role="status"
    aria-live="polite"
  >
    <div
      class="text-strong mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-(--border)"
    >
      <Icon name="check" class="size-5" aria-hidden="true" />
    </div>
    <h3 class="text-body-16 text-strong mb-2 font-semibold">
      {success.title}
    </h3>
    <p class="text-body-14 text-muted mx-auto max-w-sm">
      {success.description}
    </p>
  </div>

  <form id="contact-form" class="space-y-6" data-wmcp="contact" novalidate>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <Input
        id="name"
        name="name"
        type="text"
        required
        label={labels.name}
        class="contact-input"
        placeholder={placeholders.name}
        autocomplete="name"
      />
      <Input
        id="email"
        name="email"
        type="email"
        label={labels.email}
        required
        class="contact-input"
        placeholder={placeholders.email}
        autocomplete="email"
      />
    </div>

    <Input
      id="subject"
      name="subject"
      type="text"
      label={labels.subject}
      required
      class="contact-input"
      placeholder={placeholders.subject}
      autocomplete="subject"
    />

    <Textarea
      id="message"
      name="message"
      label={labels.message}
      required
      rows="4"
      class="contact-input"
      placeholder={placeholders.message}
      helper={helper}
      autocomplete="off"
    />

    <div
      class="flex flex-col justify-between gap-4 pt-2 sm:flex-row sm:items-center"
    >
      <div class="flex items-center gap-2">
        <Icon
          name="info"
          fill
          class="size-4.5 items-start text-(--fg-subtle)"
          aria-hidden="true"
        />
        <span class="text-label-14 text-(--fg-muted)">
          {success.description}
        </span>
      </div>
      <Button
        id="submit-btn"
        type="submit"
        size="md"
        variant="primary"
        data-default-text={button.text}
        data-loading-text={button.loading}
        aria-label={button.text}
      >
        <Spinner id="btn-spinner" size="sm" class="hidden" aria-hidden="true" />
        <span id="btn-text">{button.text}</span>
      </Button>
    </div>

    <Card
      id="error-message"
      padding="sm"
      radius="sm"
      class="text-label-13 mt-4 hidden bg-(--color-error)/10 text-center text-(--color-error) ring-(--error-soft)!"
      role="alert"
      aria-live="assertive"
    >
      <div class="flex items-center gap-2">
        <Icon name="warning" fill class="size-4.5" aria-hidden="true" />
        <span>{error.description}</span>
      </div>
    </Card>
  </form>
</div>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const successMessage = document.getElementById("success-message");
  const errorMessage = document.getElementById("error-message");
  const submitBtn = document.getElementById(
    "submit-btn",
  ) as HTMLButtonElement | null;
  const btnText = document.getElementById("btn-text") as HTMLElement | null;
  const btnSpinner = document.getElementById(
    "btn-spinner",
  ) as HTMLElement | null;
  const formInputs = document.querySelectorAll<
    HTMLInputElement | HTMLTextAreaElement
  >(".contact-input");

  const FORM_ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT || "";

  const defaultText = submitBtn?.dataset.defaultText || "Send Message";
  const loadingText = submitBtn?.dataset.loadingText || "Sending...";

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (errorMessage) errorMessage.classList.add("hidden");

      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = loadingText;
      if (btnSpinner) btnSpinner.classList.remove("hidden");
      formInputs.forEach((input) => {
        (input as HTMLInputElement | HTMLTextAreaElement).disabled = true;
      });

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch(FORM_ENDPOINT, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.classList.add("hidden");
          if (successMessage) successMessage.classList.remove("hidden");
        } else {
          throw new Error("Failed to send");
        }
      } catch {
        if (errorMessage) errorMessage.classList.remove("hidden");
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = defaultText;
        if (btnSpinner) btnSpinner.classList.add("hidden");
        formInputs.forEach((input) => {
          (input as HTMLInputElement | HTMLTextAreaElement).disabled = false;
        });
      }
    });
  }
</script>

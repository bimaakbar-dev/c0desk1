---
// src/components/SearchBar.astro
import Icon from "./Icons.astro";
import Button from "./Button.astro";

interface Props {
  iconOnly?: boolean;
  class?: string;
}

const { iconOnly = false, class: className = "" } = Astro.props;
---

{
  iconOnly && (
    <Button
      data-drawer-trigger="search-drawer"
      aria-label="Buka pencarian"
      variant="icon"
      size="md"
    >
      <Icon name="search" class="size-4.5" />
    </Button>
  )
}
{
  !iconOnly && (
    <Button
      data-drawer-trigger="search-drawer"
      aria-label="Buka pencarian"
      variant="secondary"
      size="md"
      block
      class:list={[
        "group flex w-auto items-center justify-between rounded-md! text-(--fg-muted)",
        className,
      ]}
      prefix={<Icon name="search" class="size-4" />}
      suffix={
        <div class="pointer-events-none hidden items-center gap-1 font-mono text-[10px] font-medium text-(--fg-muted) transition-colors select-none group-hover:text-(--fg) lg:flex">
          <kbd class="flex h-5 min-w-5 items-center justify-center rounded border border-(--border-subtle) bg-(--bg-muted) px-1.5 shadow-[0_1px_0_0_rgba(0,0,0,0.05)]">
            Ctrl
          </kbd>
          <kbd class="flex h-5 min-w-5 items-center justify-center rounded border border-(--border-subtle) bg-(--bg-muted) px-1.5 shadow-[0_1px_0_0_rgba(0,0,0,0.05)]">
            K
          </kbd>
        </div>
      }
    >
      Search...
    </Button>
  )
}

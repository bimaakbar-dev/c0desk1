---
//src/ui/Logo.astro
import { 
    SITE, 
    ROUTES 
} from "@/consts";

import Button from "./Button.astro";
import L from "../../assets/images/logo.svg"


interface Props {
  label?: boolean;
}

const { 
    label = true 
} = Astro.props;

const $ = {
    wrapper: "p-0! hover:bg-transparent! active:bg-transparent!",
    logo: "size-6 text-(--fg-strong)",
    label: "text-heading-24 font-semibold text-(--fg-strong)"
}

 const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	fetchpriority: 'high' as const,
	width: 48,
	height: 48,
	alt: SITE.name
};

---
<Button
    href={ROUTES.home}
    aria-label={SITE.name}
    variant="ghost"
    size="lg"
    class={$.wrapper}>
    <L class={$.logo} />
    {label && ( 
        <span class={$.label}>
            {SITE.name}
        </span> 
    )}
    <br />
</Button>

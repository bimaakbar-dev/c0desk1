---
import Input from "@ui/Input.astro";
import Button from "@ui/Button.astro";
import Icon from "@ui/Icons.astro";
import Spinner from "@ui/Spinner.astro";

const PAGE_SIZE = 5;
---

<dialog
  id="search-drawer"
  aria-label="Search"
  class="search-dialog"
  data-wmcp="search"
>
  <!-- Search bar -->
  <search
    class="flex shrink-0 items-center gap-2 border-b border-(--border) px-3 py-2"
  >
    <Input
      id="search-input"
      type="text"
      role="combobox"
      aria-autocomplete="list"
      aria-controls="search-list"
      aria-expanded="false"
      placeholder="Search..."
      autocomplete="off"
      spellcheck="false"
    >
      <Fragment slot="prefix">
        <div class="relative flex size-5 shrink-0 items-center justify-center">
          <Icon
            id="search-icon"
            name="search"
            class="size-full transition-opacity duration-(--duration)"
          />
          <Spinner
            id="search-spinner"
            size="sm"
            class="absolute inset-0 hidden size-5! text-(--fg)/80"
          />
        </div>
      </Fragment>
    </Input>
    <Button
      data-action="close-search"
      aria-label="Close Search"
      variant="icon"
      size="md"
      class="inline-flex! shrink-0 sm:hidden!"
    >
      <Icon name="close" class="size-5" />
    </Button>
    <Button
      data-action="close-search"
      aria-label="Close search"
      variant="secondary"
      size="sm"
      class="hidden! rounded! font-mono sm:inline-flex!"
    >
      ESC
    </Button>
  </search>

  <!-- Results -->
  <div id="search-results" class="flex-1 overflow-y-auto overscroll-contain">
    <div
      id="search-total"
      class="hidden border-b border-(--border-subtle) px-4 py-2 text-xs text-(--fg-muted)"
    >
    </div>
    <div id="search-empty" class="hidden"></div>
    <ul
      id="search-list"
      class="hidden divide-y divide-(--border-subtle)"
      role="listbox"
      aria-label="Search result"
    >
    </ul>
    <div id="search-footer" class="hidden p-3">
      <Button id="search-load-more" variant="secondary" size="md" block>
        Load more
      </Button>
    </div>
  </div>

  <!-- Footer branding -->
  <div
    class="flex shrink-0 items-center justify-end gap-1.5 border-t border-(--border-subtle) px-3 py-2"
  >
    <span class="text-xs text-(--fg-muted)">Powered by</span>
    <span class="text-xs font-medium text-(--fg-strong)">Pagefind</span>
  </div>
</dialog>

<!-- Templates -->
<template id="tpl-result">
  <li class="result-group" role="option" aria-selected="false">
    <a
      class="result-item flex cursor-pointer items-start gap-3 px-4 py-3 outline-none"
      tabindex="-1"
    >
      <div
        class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-md bg-(--bg-muted) text-(--fg-muted)"
      >
        <span data-slot="type-icon" class="size-4">
          <Icon name='file' class="size-full" />
        </span>
      </div>
      <div class="flex min-w-0 flex-1 flex-col gap-0.5">
        <div class="flex items-center gap-2">
          <span
            data-slot="type-label"
            class="shrink-0 text-xs text-(--fg-muted)"></span>
        </div>
        <span
          data-slot="title"
          class="text-label-14 truncate font-medium text-(--fg-strong)"></span>
        <span
          data-slot="excerpt"
          class="result-excerpt line-clamp-2 text-sm text-(--fg-muted)"></span>
      </div>
      <Icon
        name="arrow-right"
        class="mt-1 size-3.5 shrink-0 text-(--fg-muted) opacity-0 group-hover:opacity-100"
      />
    </a>
    <ul
      data-slot="subs"
      class="sub-results-list divide-y divide-(--border-subtle)/60"
    >
    </ul>
  </li>
</template>

<template id="tpl-subresult">
  <li
    class="sub-result relative flex justify-start pr-3 pl-8"
    role="option"
    aria-selected="false"
  >
    <a
      class="sub-result-item flex w-full cursor-pointer items-start gap-2 py-2 pl-2 outline-none"
      tabindex="-1"
    >
      <div class="flex min-w-0 flex-col gap-0.5">
        <span data-slot="title" class="text-label-13 truncate text-(--fg)"
        ></span>
        <span
          data-slot="excerpt"
          class="result-excerpt line-clamp-1 text-xs text-(--fg-muted)"></span>
      </div>
    </a>
  </li>
</template>

<template id="tpl-empty">
  <div
    class="flex flex-col items-center justify-center gap-3 px-4 py-16 text-center"
  >
    <div
      class="flex size-12 items-center justify-center rounded-full bg-(--bg-muted)"
    >
      <Icon name="search" class="size-5 text-(--fg-muted)" />
    </div>
    <div>
      <p class="text-label-14 font-medium text-(--fg-strong)">
        Tidak ada hasil
      </p>
      <p class="mt-1 text-sm text-(--fg-muted)">Coba kata kunci yang berbeda</p>
    </div>
  </div>
</template>

<template id="tpl-initial">
  <div
    class="flex flex-col items-center justify-center gap-3 px-4 py-16 text-center"
  >
    <div
      class="flex size-12 items-center justify-center rounded-full bg-(--bg-muted)"
    >
      <Icon name="search" class="size-5 text-(--fg-muted)" />
    </div>
    <div>
      <p class="text-label-14 font-medium text-(--fg-strong)">Search</p>
      <p class="mt-1 text-sm text-(--fg-muted)">Type to start searching</p>
    </div>
  </div>
</template>

<style is:global>
  .search-dialog {
    display: none;
    top: 0;
    flex-direction: column;
    margin: auto;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--border) 40%, transparent),
      0 20px 60px -10px hsl(0 0% 0% / 0.4);
    border: none;
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    border-radius: 0.75rem;
    background: var(--bg);
    padding: 0;
    width: min(42rem, 90vw);
    max-height: min(80dvh, 40rem);
    overflow: hidden;
    color: var(--fg);
  }

  .search-dialog[open] {
    display: flex;
  }

  .search-dialog::backdrop {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    background: var(--bg-overlay);
  }

  @keyframes dialog-in {
    from {
      transform: translateY(4px) scale(0.99);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .search-dialog[open] {
    animation: dialog-in 150ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .search-dialog[open]::backdrop {
    animation: backdrop-in 150ms ease forwards;
  }

  @media (max-width: 40rem) {
    dialog.search-dialog {
      position: fixed !important;
      margin: 0 !important;
      inset: 0 !important;
      border: none !important;
      border-radius: 0 !important;
      width: 100dvw !important;
      max-width: 100dvw !important;
      height: 100dvh !important;
      max-height: 100dvh !important;
    }

    @keyframes dialog-in {
      from {
        transform: scale(0.99);
        opacity: 0;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open],
    .search-dialog[open]::backdrop {
      animation: none;
    }
  }

  .result-item:hover,
  .sub-result-item:hover {
    background-color: var(--bg-muted);
  }

  .result-item[aria-selected="true"],
  .sub-result-item[aria-selected="true"] {
    background-color: var(--bg-subtle);
  }

  .sub-result::before {
    position: absolute;
    top: 0;
    left: 1.125rem;
    border-bottom: 1.5px solid var(--border);
    border-left: 1.5px solid var(--border);
    border-bottom-left-radius: 0.25rem;
    width: 0.75rem;
    height: 1rem;
    content: "";
  }

  .sub-result:not(:last-of-type)::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1.125rem;
    border-left: 1.5px solid var(--border);
    content: "";
  }

  .result-excerpt mark {
    border-radius: 0.125rem !important;
    background-color: color-mix(
      in srgb,
      var(--accent) 20%,
      transparent
    ) !important;
    padding: 0 0.25rem !important;
    color: var(--accent) !important;
  }
</style>

<script is:inline define:vars={{ PAGE_SIZE }}>
  (() => {
    const $ = (id) => document.getElementById(id);

    const drawerEl = $("search-drawer");
    const input = $("search-input");
    const list = $("search-list");
    const emptyEl = $("search-empty");
    const totalEl = $("search-total");
    const footerEl = $("search-footer");
    const loadMoreBtn = $("search-load-more");
    const iconEl = $("search-icon");
    const spinnerEl = $("search-spinner");

    const tplResult = $("tpl-result");
    const tplSubresult = $("tpl-subresult");
    const tplEmpty = $("tpl-empty");
    const tplInitial = $("tpl-initial");

    let isOpen = false;
    let pf = null;
    let pfLoader = null;
    let results = [];
    let rendered = 0;
    let token = 0;
    let activeIdx = -1;

    // ── Helpers ──────────────────────────────────────────────────────────

    function stripHtml(html) {
      const tmp = document.createElement("div");
      tmp.innerHTML = html;
      return tmp.textContent || tmp.innerText || "";
    }

    function cleanExcerpt(raw, maxLen = 160) {
      if (!raw) return "";
      // Keep <mark> tags, strip everything else
      const cleaned = raw.replace(/<(?!\/?mark(\s|>))[^>]+>/gi, "");
      return cleaned.length > maxLen
        ? cleaned.slice(0, maxLen).trimEnd() + "…"
        : cleaned;
    }

    function getTypeFromUrl(url) {
      if (url.includes("/docs/")) return { label: "Docs", icon: "learn" };
      if (url.includes("/blog/")) return { label: "Blog", icon: "blog" };
      if (url.includes("/legal/")) return { label: "Legal", icon: "info" };
      return { label: "Page", icon: "link" };
    }

    function loadPF() {
      if (!pfLoader)
        pfLoader = import("/pagefind/pagefind.js").then(async (m) => {
          pf = m;
          await pf.init();
        });
      return pfLoader;
    }

    function setLoading(on) {
      iconEl?.classList.toggle("opacity-0", on);
      spinnerEl?.classList.toggle("hidden", !on);
    }

    function getFocusables() {
      return [...list.querySelectorAll("a[tabindex]")];
    }

    // ── State ─────────────────────────────────────────────────────────────

    function reset() {
      list.innerHTML = "";
      list.classList.add("hidden");
      emptyEl.innerHTML = "";
      emptyEl.classList.add("hidden");
      totalEl.classList.add("hidden");
      footerEl.classList.add("hidden");
      input?.setAttribute("aria-expanded", "false");
      results = [];
      rendered = 0;
      activeIdx = -1;
    }

    function showInitial() {
      emptyEl.appendChild(tplInitial.content.cloneNode(true));
      emptyEl.classList.remove("hidden");
    }

    function showEmpty() {
      emptyEl.appendChild(tplEmpty.content.cloneNode(true));
      emptyEl.classList.remove("hidden");
    }

    function updateTotal() {
      totalEl.textContent = `${results.length} hasil ditemukan`;
      totalEl.classList.remove("hidden");
    }

    function updateFooter() {
      footerEl.classList.toggle("hidden", rendered >= results.length);
    }

    // ── Keyboard nav ──────────────────────────────────────────────────────

    function setActive(idx) {
      const links = getFocusables();
      if (!links.length) return;

      idx = Math.max(-1, Math.min(idx, links.length - 1));

      links.forEach((a) => {
        a.closest('[role="option"]')?.setAttribute("aria-selected", "false");
      });

      activeIdx = idx;

      if (idx === -1) {
        input?.focus();
        return;
      }

      const target = links[idx];
      target.closest('[role="option"]')?.setAttribute("aria-selected", "true");
      target.scrollIntoView({ block: "nearest" });
    }

    // ── Build DOM ─────────────────────────────────────────────────────────

    function buildSub(sub) {
      const node = tplSubresult.content.cloneNode(true);
      node.querySelector("a").href = sub.url;

      const title = sub.title || stripHtml(sub.excerpt) || sub.url;
      node.querySelector('[data-slot="title"]').textContent = title;

      const excEl = node.querySelector('[data-slot="excerpt"]');
      const exc = cleanExcerpt(sub.excerpt, 100);
      if (exc) excEl.innerHTML = exc;
      else excEl.remove();

      return node;
    }

    function buildResult(item) {
      const node = tplResult.content.cloneNode(true);
      const type = getTypeFromUrl(item.url);

      node.querySelector("a").href = item.url;

      // Type icon & label
      const typeIcon = node.querySelector('[data-slot="type-icon"]');
      const typeLabel = node.querySelector('[data-slot="type-label"]');
      typeIcon.setAttribute("data-icon", type.icon);
      typeIcon.className = `icon size-4`;
      typeLabel.textContent = type.label;

      // Title
      const title = item.meta?.title || stripHtml(item.excerpt) || item.url;
      node.querySelector('[data-slot="title"]').textContent = title;

      // Excerpt
      const excEl = node.querySelector('[data-slot="excerpt"]');
      const exc = cleanExcerpt(item.excerpt || item.meta?.description, 160);
      if (exc) excEl.innerHTML = exc;
      else excEl.remove();

      // Sub results
      const subsEl = node.querySelector('[data-slot="subs"]');
      const subs = (item.sub_results ?? [])
        .filter((s) => s.url !== item.url && s.excerpt)
        .slice(0, 3);
      if (subs.length) subs.forEach((s) => subsEl.appendChild(buildSub(s)));
      else subsEl.remove();

      return node;
    }

    // ── Render ────────────────────────────────────────────────────────────

    async function renderPage(t) {
      const batch = results.slice(rendered, rendered + PAGE_SIZE);
      if (!batch.length) return;

      const items = await Promise.all(batch.map((r) => r.data()));
      if (t !== token) return;

      const frag = document.createDocumentFragment();
      items.forEach((i) => frag.appendChild(buildResult(i)));
      list.appendChild(frag);
      rendered += batch.length;
      updateFooter();
    }

    async function search() {
      const t = ++token;
      const query = input.value.trim();

      reset();
      if (!query) {
        showInitial();
        setLoading(false);
        return;
      }

      setLoading(true);
      await loadPF();

      const res = await pf.debouncedSearch(query);
      if (t !== token) return;

      results = res?.results ?? [];
      rendered = 0;

      if (!results.length) {
        showEmpty();
        setLoading(false);
        return;
      }

      updateTotal();
      list.classList.remove("hidden");
      input.setAttribute("aria-expanded", "true");

      await renderPage(t);
      if (t === token) setLoading(false);
    }

    // ── Dialog ────────────────────────────────────────────────────────────

    function open(targetId) {
      if (targetId && targetId !== "search-drawer") return;
      if (isOpen || !drawerEl) return;

      loadPF();
      drawerEl.showModal();
      document.body.style.overflow = "hidden";
      isOpen = true;
      reset();
      showInitial();
      setTimeout(() => input?.focus(), 50);
    }

    function close() {
      if (!drawerEl || !isOpen) return;
      drawerEl.close();
    }

    drawerEl.addEventListener("close", () => {
      document.body.style.overflow = "";
      isOpen = false;
      if (input) input.value = "";
      reset();
      setLoading(false);
    });

    drawerEl.addEventListener("click", (e) => {
      if (e.target === drawerEl) close();
    });

    loadMoreBtn?.addEventListener("click", () => renderPage(token));
    input?.addEventListener("input", search);

    // ── Keyboard ──────────────────────────────────────────────────────────

    document.addEventListener("keydown", (e) => {
      if (!isOpen) {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          open("search-drawer");
        }
        return;
      }

      if (e.key === "Escape") {
        close();
        return;
      }

      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIdx + 1);
        return;
      }
      if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIdx - 1);
        return;
      }

      if (e.key === "Enter" && activeIdx >= 0) {
        e.preventDefault();
        getFocusables()[activeIdx]?.click();
        return;
      }

      if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        close();
        return;
      }

      if (activeIdx >= 0 && e.key.length === 1 && !e.metaKey && !e.ctrlKey) {
        setActive(-1);
        input?.focus();
      }
    });

    document.addEventListener("click", (e) => {
      const trigger = e.target.closest("[data-drawer-trigger]");
      if (trigger) {
        e.preventDefault();
        open(trigger.dataset.drawerTrigger);
        return;
      }

      if (e.target.closest('[data-action="close-search"]')) {
        e.preventDefault();
        close();
      }
    });
  })();
</script>

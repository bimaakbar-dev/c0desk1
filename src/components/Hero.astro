---
import { Image } from 'astro:assets';

import Section from "@ui/Section.astro";
import Particles from '@ui/Particles.astro';
import Button from "@ui/Button.astro";
import Icon from "@ui/Icons.astro";
import Badge from "@ui/Badge.astro";

interface Props {
  tagline?: string;
  title: string;
  image?: any;
  imageAlt: string;
  action?: string;
  actionLabel?: string
  action2?: string;
  action2Label?: string
}

const { 
  tagline,
  image,
  imageAlt,
  title,
  action,
  actionLabel,
  action2,
  action2Label
 } = Astro.props;

 const imageAttrs = {
	loading: 'eager' as const,
	decoding: 'async' as const,
	fetchpriority: 'high' as const,
	width: 400,
	height: 400,
	alt: imageAlt || title,
};

const $ = {
	badge: "text-label-14 font-medium",
  	title: "text-heading-32 md:text-heading-48 font-medium text-(--fg-strong) text-balance",
}
---

<Section size="none" class="hero">
  <Particles />
  
  <div class="flex stack">
    <div class="flex meta">
      	{tagline && ( 
	    	<Badge variant="accent" class={$.badge} set:html={tagline} /> 
		)}
      	<h1 class={$.title} set:html={title} />
    </div>
    <div class="flex actions">
      {action && ( 
        <Button 
          variant="primary" 
          size="lg" 
          href={action} 
        >{actionLabel}
        </Button>
      )}
      {action2 && ( 
        <Button 
          variant="ghost" 
          size="lg" 
          href={action2} 
          suffix={<Icon name="arrow-right" />} 
        >{action2Label}
        </Button> 
      )}
    </div>
  </div>
  <Image src={image} {...imageAttrs} />
</Section>
<style is:global>
  	.hero {
		display: grid;
    	position: relative;
		grid-template-columns: 100%;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1rem;
	}
  	.hero > img {
		object-fit: contain;
		width: min(70%, 20rem);
		height: auto;
		margin-inline: auto;
	}
  	.stack {
		flex-direction: column;
		gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
		text-align: center;
    	z-index: 10;
	}
  	.meta {
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}
	.meta > * {
		max-width: 50ch;
	}
  	.actions {
		gap: 1rem 2rem;
		flex-wrap: wrap;
		justify-content: center;
	}
  	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: 7fr 4fr;
			gap: 3%;
			padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
		}
		.hero > img {
			order: 2;
			width: min(100%, 25rem);
		}
		.stack {
			text-align: start;
		}
    	.meta {
			align-items: flex-start;
		}
		.actions {
			justify-content: flex-start;
		}
	}
</style>

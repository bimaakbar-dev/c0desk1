---
// src/pages/contact.astro
import {
  CONTACT_PAGE,
  SITE,
  ROUTES,
  buildMeta,
  schemaWebPage,
  schemaOrganization,
  schemaBreadcrumb,
} from "@/consts";

import Layout from "@/layouts/Layout.astro";
import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";

import ContactForm from "@ui/ContactForm.astro";

const { 
  title, 
  description, 
  hero 
} = CONTACT_PAGE;

const baseUrl = SITE.url.replace(/\/$/, "");
const currentUrl = `${baseUrl}${ROUTES.contact}/`;

const meta = buildMeta({
  title,
  description,
  canonical: currentUrl,
  ogType: "website",
  keywords: [
    "contact", 
    "support", 
    "feedback", 
    "question"
  ],
});

const schema = [
  schemaWebPage({
    title,
    description,
    url: currentUrl,
    type: "ContactPage",
  }),
  schemaOrganization,
  schemaBreadcrumb([
    { name: "Home", url: `${baseUrl}/` },
    { name: title, url: currentUrl },
  ]),
];
---

<Layout {meta} {schema}>
  <main id="main-content" class="w-full min-w-0 flex-1">
    <div class="relative flex w-full flex-1 flex-col items-center pb-(--safe-bottom)">
      <Container size="xl">
        <Section
          size="lg"
          class="pt-16 md:pt-24 lg:pt-32 pb-12 md:pb-20 lg:pb-28"
        >
          <div class="grid grid-cols-12 gap-x-6 gap-y-8 lg:gap-y-10">
            <div class="col-span-full lg:col-span-7 flex flex-col gap-4">
              <h1 class="text-heading-32 md:text-heading-48 lg:text-heading-64 text-balance font-medium text-(--fg-strong) max-w-[14ch]">
                {hero.title}
              </h1>
            </div>
            <div class="col-span-full lg:col-span-5 flex flex-col gap-8 lg:py-2">
              <p class="text-body-16 md:text-body-18 text-balance text-(--fg-muted) max-w-[48ch]">
                {hero.description}
              </p>
            </div>
          </div>
        </Section>
      </Container>
      <Container size="xl">
        <Section size="lg" class="py-12 md:py-16 lg:py-24">
          <div class="grid grid-cols-12 gap-x-6 gap-y-6">
            <div class="col-span-full lg:col-span-8 lg:col-start-3">
              <ContactForm />
            </div>
          </div>
        </Section>
      </Container>
    </div>
  </main>
</Layout>
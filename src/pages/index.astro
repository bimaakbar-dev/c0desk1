---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import AgentPanel from "../components/AgentPanel";
import AutomationStatus from "../components/AutomationStatus";
import Chatbox from "../components/Chatbox";
import FloatingBar from "../components/FloatingBar";
import { getAutomationStatus } from "../lib/automationStatus";

const automationStatus = await getAutomationStatus();
---
<Layout title="Hera Studio — ruang kerja AI">
  <main class="min-h-screen flex flex-col text-foreground">
    <header class="studio-header shrink-0 px-4 py-3 md:px-7">
      <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-3 no-underline text-foreground" aria-label="Hera Studio beranda">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="flex flex-col leading-tight">
            <span class="text-sm font-semibold tracking-tight">c0desk1 <span class="text-muted-foreground font-normal">/ studio</span></span>
            <span class="text-[10px] text-muted-foreground tracking-wide">RUANG KERJA AI</span>
          </span>
        </a>
        <AutomationStatus snapshot={automationStatus} />
      </div>
    </header>

    <div class="mx-auto grid w-full max-w-[1600px] flex-1 grid-cols-1 gap-4 px-3 py-4 pb-24 md:px-6 md:py-6 lg:grid-cols-[minmax(0,1.65fr)_minmax(320px,0.85fr)] lg:items-stretch">
      <section class="flex min-h-[540px] flex-col gap-4 lg:min-h-0" aria-labelledby="room-title">
        <div class="flex flex-wrap items-end justify-between gap-3 px-1">
          <div>
            <p class="section-eyebrow mb-1">STUDIO · SESI TIM</p>
            <h1 id="room-title" class="text-xl font-semibold tracking-tight sm:text-2xl">Ruang kerja</h1>
            <p class="mt-1 text-xs text-muted-foreground">Brief-in tim, lalu lihat bagaimana mereka bekerja.</p>
          </div>
          <div class="room-chip" aria-label="3 agent tersedia">
            <span class="room-chip-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            3 agent
          </div>
        </div>

        <div class="meeting-stage">
          <div class="meeting-stage-topline" aria-hidden="true">
            <span>HERA STUDIO</span><span>WORKSPACE / 01</span>
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <AgentPanel agentId="hera" client:only="react" />
            <AgentPanel agentId="ares" client:only="react" />
            <AgentPanel agentId="hades" client:only="react" />
            <div class="host-tile">
              <div class="flex items-center justify-between">
                <span class="host-live"><span></span>RUANG ANDA</span>
                <span class="text-[10px] text-muted-foreground">KOMANDAN</span>
              </div>
              <div class="host-avatar" aria-hidden="true">B</div>
              <div>
                <p class="text-sm font-medium">Anda</p>
                <p class="mt-1 text-xs text-muted-foreground">Berikan instruksi lewat chat</p>
              </div>
            </div>
          </div>
          <div class="meeting-stage-footer">
            <span>AGENT ROOM</span><span>Aktivitas ditampilkan saat agent bekerja</span>
          </div>
        </div>
      </section>

      <aside class="chat-column" aria-label="Percakapan dengan tim AI">
        <div class="chat-heading">
          <div>
            <p class="section-eyebrow mb-1">CHAT · KOMANDO</p>
            <h2 class="text-base font-semibold">Percakapan tim</h2>
          </div>
          <span class="chat-heading-icon" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"/></svg>
+          </span>
+        </div>
+        <div class="chat-surface">
+          <Chatbox client:only="react" />
+        </div>
+        <p class="chat-note"><span aria-hidden="true">↳</span> Sebut <code>@hera</code>, <code>@ares</code>, atau <code>@hades</code> untuk mengarahkan pesan.</p>
+      </aside>
+    </div>
+
+    <FloatingBar client:only="react" />
+  </main>
+</Layout>

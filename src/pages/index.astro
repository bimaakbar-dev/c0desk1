---
// src/pages/index.astro
import { SITE, ROUTES, buildMeta, schemaWebPage } from "@/consts";

import { canonicalUrl } from "@/lib/utils";

import { features } from "@/config/pages";
import { Image } from "astro:assets";

import Layout from "@/layouts/Layout.astro";
import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";
import Card from "@ui/Card.astro";
import Button from "@ui/Button.astro";
import Icons from "@ui/Icons.astro";
import Hero from "@/components/Hero.astro";
import HeroImage from "@/assets/images/hero-image.svg";
import HeroImageDesktop from "@/assets/images/hero-image-desktop.svg";
import HeroImageMobile from "@/assets/images/hero-image-mobile.svg";

const meta = buildMeta({
  description: SITE.description,
  canonical: canonicalUrl(),
  ogType: "website",
});

const schema = [
  schemaWebPage({
    title: SITE.name,
    description: SITE.description,
    url: canonicalUrl(),
  }),
];

const imageAttrs = {
  loading: "lazy" as const,
  decoding: "async" as const,
  fetchpriority: "high" as const,
  width: 1200,
  height: 400,
  alt: "Hero illustration",
};
---

<Layout {meta} {schema} isHome>
  <main id="main-content" class="w-full min-w-0 flex-1">
    <div
      class="relative flex w-full flex-1 flex-col items-center pb-(--safe-bottom)"
    >
      <Container size="xl">
        <Section size="md">
          <Hero
            tagline={SITE.tagline}
            title={SITE.title}
            image={HeroImage}
            imageAlt="Stradocs Hero Illustration"
            action="#start"
            actionLabel="Get Started"
          />
        </Section>
      </Container>
      <Container size="full" class="px-0!">
        <hr />
      </Container>
      <Container size="lg">
        <Section size="md">
          <p class="text-heading-32">
            This is a customizable documentation template built with <span
              class="text-(--accent)">Astro</span
            >. It's designed to help you create beautiful documentation quickly.
          </p>
        </Section>
      </Container>
      <Container size="full" class="px-0!">
        <hr />
      </Container>
      <Container size="lg">
        <Section size="md">
          <div class="mb-10 text-center">
            <h2
              class="text-heading-24 lg:text-heading-32 font-medium text-(--fg-strong)"
            >
              Why Choose This Theme?
            </h2>
          </div>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
            {
              features.map((f) => (
                <Card
                  padding="lg"
                  radius="md"
                  variant="secondary"
                  class="text-start hover:shadow-md"
                >
                  <div class="mb-3 flex items-center">
                    <Icons name={f.icon} class="text-brand size-6" />
                  </div>
                  <h3 class="text-heading-18 font-semibold text-(--fg-strong)">
                    {f.title}
                  </h3>
                  <p class="text-body-14 mt-1 text-(--fg-muted)">{f.desc}</p>
                </Card>
              ))
            }
          </div>
        </Section>
      </Container>
      <Container size="full" class="px-0!">
        <hr />
      </Container>
      <Image src={HeroImageDesktop} {...imageAttrs} />
      <Container size="lg">
        <Section size="md">
          <div class="mb-10 text-center">
            <h2
              class="text-heading-24 lg:text-heading-32 font-medium text-(--fg-strong)"
            >
              Support Markdown & MDX
            </h2>
            <p class="text-heading-32 mt-2">
              Native support for the essential standards. Extended through
              Satteri directives—only when you need it.
            </p>
          </div>
        </Section>
      </Container>
      <Container size="full" class="px-0!">
        <hr />
      </Container>
      <Container size="lg">
        <Section size="md">
          <div class="mb-10 text-center">
            <h2
              class="text-heading-24 lg:text-heading-32 font-medium text-(--accent)"
            >
              Forever Open Source.
            </h2>
            <p class="text-heading-32 mt-2">
              Modify, extend, or strip it down. It's completely open.
            </p>
          </div>
        </Section>
      </Container>
      <Container size="full" class="px-0!">
        <hr />
      </Container>
      <Image src={HeroImageMobile} {...imageAttrs} />
      <Container size="xl">
        <Section size="lg" class="py-12 md:py-16 lg:py-24">
          <div class="grid grid-cols-12 gap-x-6 gap-y-6">
            <div
              class="col-span-full flex flex-col items-center justify-center gap-8 md:gap-10 lg:flex-row lg:gap-12"
            >
              <h2
                id="start"
                class="text-heading-32 md:text-heading-40 lg:text-heading-48 max-w-[16ch] text-center font-medium text-balance text-(--fg-strong) lg:text-left"
              >
                Ready to Explore?
              </h2>
              <div class="flex flex-wrap items-center justify-center gap-4">
                <Button href={`${ROUTES.docs}/`} variant="primary" size="lg">
                  View Docs
                </Button>
                <Button
                  href="https://github.com/bimaakbar-dev/stradocs"
                  variant="ghost"
                  size="lg"
                  suffix={(<Icons name="external" class="size-4.5" />)}
                >
                  GitHub
                </Button>
              </div>
            </div>
          </div>
        </Section>
      </Container>
    </div>
  </main>
</Layout>

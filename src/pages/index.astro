---
// src/pages/index.astro
import {
  SITE,
  ROUTES,
  buildMeta,
  schemaWebPage
} from "@/consts";

import { 
  canonicalUrl 
} from "@/lib/utils";

import { features } from "@/config/pages";

import Layout from "@/layouts/Layout.astro";
import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";
import Card from "@ui/Card.astro";
import Button from "@ui/Button.astro";
import Icons from "@ui/Icons.astro";
import Hero from "@/components/Hero.astro";
import HeroImage from "@/assets/images/logo.webp";

const meta = buildMeta({
  description: SITE.description,
  canonical: canonicalUrl(),
  ogType: "website",
});

const schema = [
  schemaWebPage({
    title: SITE.name,
    description: SITE.description,
    url: canonicalUrl(),
  })
];
---

<Layout {meta} {schema} isHome>
  <main id="main-content" class="w-full min-w-0 flex-1">
    <div class="relative flex w-full flex-1 flex-col items-center pb-(--safe-bottom)">
      <Container size="xl">
        <Section size="md">
          <Hero
            image={HeroImage}
            imageAlt="Hero illustration"
            title={SITE.description}
          />
        </Section>
      </Container>
      <Container size="lg">
        <Section size="md">
          <div class="text-center mb-10">
            <h2 class="text-heading-40 text-(--fg-strong)">
              Why Choose This Theme?
            </h2>
            <p class="text-body-16 text-(--fg-muted) mt-2">
              Designed for developers who value speed and simplicity.
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {features.map((f) => (
              <Card padding="lg" radius="md" variant='secondary' class="text-center hover:shadow-md">
                <div class="flex justify-center mb-3">
                  <Icons name={f.icon} class="size-8 text-brand" />
                </div>
                <h3 class="text-heading-18 font-semibold text-(--fg-strong)">
                  {f.title}
                </h3>
                <p class="text-body-14 text-(--fg-muted) mt-1">{f.desc}</p>
              </Card>
            ))}
          </div>
        </Section>
      </Container>
      <Container size="xl">
        <Section size="lg" class="py-12 md:py-16 lg:py-24">
          <div class="grid grid-cols-12 gap-x-6 gap-y-6">
            <div class="col-span-full flex flex-col items-center justify-center gap-8 md:gap-10 lg:flex-row lg:gap-12">
              <h2 class="text-heading-28 md:text-heading-40 lg:text-heading-48 font-medium text-(--fg-strong) text-center lg:text-left text-balance max-w-[16ch]">
                Ready to Explore?
              </h2>
              <div class="flex flex-wrap items-center justify-center gap-4">
                <Button
                  href={`${ROUTES.docs}/`}
                  variant="primary"
                  size="lg"
                  suffix={<Icons name="arrow-right" class="size-4.5" />}
                >
                  View Documents
                </Button>
                <Button
                  href="https://github.com/bimaakbar-dev"
                  variant="ghost"
                  size="lg"
                  suffix={<Icons name="external" class="size-4.5" />}
                >
                  GitHub
                </Button>
              </div>
            </div>
          </div>
        </Section>
      </Container>

    </div>
  </main>
</Layout>

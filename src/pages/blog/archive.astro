---
// src/pages/blog/archive.astro

import { getCollection, type CollectionEntry } from "astro:content";

import {
  HOME_PAGE,
  BLOG_PAGE,
  ARCHIVE_PAGE,
  SITE,
  ROUTES,
  IMAGE,
  buildMeta,
  schemaWebPage,
  schemaBreadcrumb,
} from "@/consts";

import { canonicalUrl, getSlug, formatDateCompact } from "@/lib/utils";

import Layout from "@/layouts/Layout.astro";
import Section from "@ui/Section.astro";
import Container from "@ui/Container.astro";
import Card from "@ui/Card.astro";
import Button from "@ui/Button.astro";
import Badge from "@ui/Badge.astro";

type BlogEntry = CollectionEntry<"blog">;

const allPosts: BlogEntry[] = await getCollection(
  "blog",
  ({ data }) => !data.draft,
);

const sortedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.pubDate ?? new Date(0);
  const dateB = b.data.pubDate ?? new Date(0);
  return dateB.getTime() - dateA.getTime();
});

const formatMonthName = (monthIndex: number) => {
  return new Intl.DateTimeFormat(ARCHIVE_PAGE.locale, { month: "long" }).format(
    new Date(2000, monthIndex, 1),
  );
};

type GroupedArchive = Record<number, Record<number, BlogEntry[]>>;

const archive = sortedPosts.reduce<GroupedArchive>((acc, post) => {
  const date = post.data.pubDate ?? new Date(0);
  const year = date.getFullYear();
  const month = date.getMonth();

  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = [];

  acc[year][month].push(post);
  return acc;
}, {});

const years = Object.keys(archive)
  .map(Number)
  .sort((a, b) => b - a);
const currentYear = new Date().getFullYear();
const activeYear = years.length > 0 ? years[0] : currentYear;

const { colors, months, heatmap, breadcrumb } = ARCHIVE_PAGE;

function getYearActivity(year: number) {
  if (!archive[year]) return [];
  const posts = Object.values(archive[year]).flat();
  const postCounts: Record<string, number> = {};

  posts.forEach((post) => {
    if (!post.data.pubDate) return;
    const dateStr = post.data.pubDate.toISOString().split("T")[0];
    postCounts[dateStr] = (postCounts[dateStr] || 0) + 1;
  });

  const grid = [];
  let current = new Date(Date.UTC(year, 0, 1));
  const endDate = new Date(Date.UTC(year, 11, 31));

  const startDay = current.getUTCDay();
  const adjustedStart = startDay === 0 ? 6 : startDay - 1;
  for (let i = 0; i < adjustedStart; i++) {
    grid.push({ date: null, count: 0, level: 0 });
  }

  while (current <= endDate) {
    const dateStr = current.toISOString().split("T")[0];
    const count = postCounts[dateStr] || 0;

    let level = 0;
    if (count === 1) level = 1;
    else if (count === 2) level = 2;
    else if (count >= 3) level = 3;

    grid.push({ date: dateStr, count, level });
    current.setUTCDate(current.getUTCDate() + 1);
  }

  return grid;
}

const activityGrid = getYearActivity(activeYear);
const activeYearTotal = archive[activeYear]
  ? Object.values(archive[activeYear]).flat().length
  : 0;
const hasPosts = allPosts.length > 0;

const canonicalURL = canonicalUrl(ROUTES.archive);

const { title, description } = ARCHIVE_PAGE;

const meta = buildMeta({
  title,
  description,
  canonical: canonicalURL,
  ogType: "website",
});

const schema = [
  schemaWebPage({
    title,
    description,
    url: canonicalURL,
    type: "CollectionPage",
    image: {
      url: SITE.logo.startsWith("http")
        ? SITE.logo
        : `${SITE.url.replace(/\/$/, "")}${SITE.logo}`,
      width: IMAGE.logo.width,
      height: IMAGE.logo.height,
      caption: title,
    },
  }),
  schemaBreadcrumb([
    { name: HOME_PAGE.title, url: canonicalUrl() },
    { name: BLOG_PAGE.title, url: canonicalUrl(ROUTES.blog) },
    { name: title, url: canonicalURL },
  ]),
];
---

<Layout {meta} {schema}>
  <main id="main-content" class="w-full min-w-0 flex-1">
    <div
      class="relative flex w-full flex-1 flex-col items-center pb-(--safe-bottom)"
    >
      <Container size="xl">
        <Section
          size="lg"
          class="pt-16 pb-12 md:pt-24 md:pb-20 lg:pt-32 lg:pb-28"
        >
          <div class="grid grid-cols-12 gap-x-6 gap-y-8 lg:gap-y-10">
            <div class="col-span-full flex flex-col gap-4 lg:col-span-7">
              <h1
                class="text-heading-32 md:text-heading-48 lg:text-heading-64 max-w-[14ch] font-medium text-balance text-(--fg-strong)"
              >
                {title}
              </h1>
            </div>
            <div
              class="col-span-full flex flex-col gap-8 lg:col-span-5 lg:py-2"
            >
              <p
                class="text-body-16 md:text-body-18 max-w-[48ch] text-balance text-(--fg-muted)"
              >
                {description}
              </p>
            </div>
          </div>
        </Section>
      </Container>

      <Container size="xl">
        <Section size="lg" class="py-12 md:py-16 lg:py-24">
          {
            !hasPosts ? (
              <Card
                padding="lg"
                radius="md"
                variant="outline"
                class="text-center"
              >
                <p class="font-medium text-(--fg-strong)">
                  {heatmap.emptyLabel}
                </p>
                <p class="mt-1 text-sm text-(--fg-muted)">
                  {heatmap.emptyDescription}
                </p>
              </Card>
            ) : (
              <>
                <div class="mb-16">
                  <Card
                    padding="lg"
                    radius="md"
                    variant="secondary"
                    class="shadow-sm"
                  >
                    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                      <div>
                        <h2 class="text-heading-18 flex items-center gap-2 font-semibold text-(--fg-strong)">
                          {heatmap.label} ({activeYear})
                        </h2>
                        <p class="mt-1 text-sm text-(--fg-muted)">
                          {heatmap.articlesLabel(activeYearTotal)}
                        </p>
                      </div>
                    </div>

                    <div class="custom-scrollbar w-full overflow-x-auto pb-4">
                      <div class="flex min-w-180 flex-col gap-2">
                        <div class="ml-8 flex justify-between pr-4 text-xs font-medium text-(--fg-muted)">
                          {months.short.map((month) => (
                            <span>{month}</span>
                          ))}
                        </div>

                        <div class="flex gap-3">
                          <div class="grid grid-rows-7 gap-1.5 pt-0.5 text-[10px] leading-3 font-medium text-(--fg-muted)">
                            <span class="invisible">Min</span>
                            {ARCHIVE_PAGE.weekdays.short.map((day) => (
                              <span>{day}</span>
                            ))}
                          </div>

                          <div class="inline-grid flex-1 grid-flow-col grid-rows-7 gap-1.5">
                            {activityGrid.map((day, index) => (
                              <div
                                class={`heatmap-cell size-3 cursor-default rounded-sm hover:ring-1 hover:ring-(--accent) ${day.date ? colors[`level${day.level}` as keyof typeof colors] : "bg-transparent"}`}
                                title={
                                  day.date
                                    ? `${day.count} ${heatmap.postsLabel(day.count)} on ${new Date(day.date).toLocaleDateString(ARCHIVE_PAGE.locale, { day: "numeric", month: "long", year: "numeric" })}`
                                    : undefined
                                }
                              />
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="mt-4 flex items-center justify-end gap-2 text-xs font-medium text-(--fg-muted)">
                      <span class="mr-1">{heatmap.legendLow}</span>
                      <div class={`size-3.5 rounded-sm ${colors.level0}`} />
                      <div class={`size-3.5 rounded-sm ${colors.level1}`} />
                      <div class={`size-3.5 rounded-sm ${colors.level2}`} />
                      <div class={`size-3.5 rounded-sm ${colors.level3}`} />
                      <span class="ml-1">{heatmap.legendHigh}</span>
                    </div>
                  </Card>

                  <div class="mt-6 flex items-center gap-3">
                    <span class="text-body-14 font-medium text-(--fg-strong)">
                      {heatmap.jumpLabel}
                    </span>
                    <div class="flex flex-wrap gap-2">
                      {years.map((year) => (
                        <Button
                          href={`#year-${year}`}
                          variant="outline"
                          size="md"
                          data-year-pill={year}
                          class="year-pill"
                        >
                          {year}
                        </Button>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="space-y-16">
                  {years.map((year) => (
                    <div
                      id={`year-${year}`}
                      class="scroll-mt-(--scroll-padding)"
                    >
                      <h2 class="text-heading-24 md:text-heading-32 mb-8 flex items-center gap-4 font-semibold text-(--fg-strong)">
                        {year}
                        <span class="h-px flex-1 bg-linear-to-r from-(--border-subtle) to-transparent" />
                      </h2>

                      <div class="relative ml-3 space-y-12 border-l border-(--border) py-2 md:ml-4">
                        {Object.keys(archive[year])
                          .map(Number)
                          .sort((a, b) => b - a)
                          .map((month) => (
                            <div class="relative pl-6 md:pl-8">
                              <div class="absolute top-1 -left-2 size-4 border-2 border-(--accent) bg-(--bg) ring-4 ring-(--bg)" />

                              <h3 class="text-label-14 mb-5 flex items-center gap-3 font-semibold text-(--fg-strong)">
                                {formatMonthName(month)}
                                <Badge variant="accent">
                                  {archive[year][month].length}{" "}
                                  {heatmap.postsLabel(
                                    archive[year][month].length,
                                  )}
                                </Badge>
                              </h3>

                              <ul class="space-y-2">
                                {archive[year][month].map((post) => {
                                  const slug = getSlug(post);
                                  const pubDate = post.data.pubDate;
                                  return (
                                    <li class="group">
                                      <Card
                                        padding="none"
                                        radius="sm"
                                        variant="primary"
                                      >
                                        <a
                                          href={canonicalUrl(
                                            `${ROUTES.blog}/${slug}`,
                                          )}
                                          class="flex flex-col justify-between gap-3 px-3 py-2 transition-colors hover:text-(--accent) sm:flex-row sm:items-center"
                                        >
                                          <span class="text-body-14 line-clamp-1 font-medium text-(--fg-muted) group-hover:text-(--fg-strong)">
                                            {post.data.title}
                                          </span>
                                          <div class="flex shrink-0 items-center gap-3">
                                            <time class="rounded bg-(--bg-muted) px-2 py-1 text-xs! text-(--fg-muted)/80">
                                              {pubDate
                                                ? formatDateCompact(
                                                    pubDate,
                                                    ARCHIVE_PAGE.locale,
                                                  )
                                                : "-"}
                                            </time>
                                          </div>
                                        </a>
                                      </Card>
                                    </li>
                                  );
                                })}
                              </ul>
                            </div>
                          ))}
                      </div>
                    </div>
                  ))}
                </div>
              </>
            )
          }
        </Section>
      </Container>
    </div>
  </main>
</Layout>

<style is:global>
  .custom-scrollbar {
    scrollbar-color: var(--border-subtle) transparent;
    scrollbar-width: thin;
  }
  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    border-radius: 10px;
    background-color: var(--border-subtle);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: var(--fg-muted);
  }

  .heatmap-cell {
    transition: box-shadow 0.15s ease;
  }

  .year-pill.is-active {
    background-color: var(--accent) !important;
    color: var(--accent-fg) !important;
  }
</style>

<script>
  document.querySelectorAll(".year-pill").forEach((pill) => {
    pill.addEventListener("click", (e) => {
      e.preventDefault();
      const targetId = pill.getAttribute("href");
      if (!targetId) return;
      const target = document.querySelector(targetId);
      if (target) {
        target.scrollIntoView({ behavior: "smooth" });
        document
          .querySelectorAll(".year-pill")
          .forEach((p) => p.classList.remove("is-active"));
        pill.classList.add("is-active");
      }
    });
  });

  const yearBlocks = document.querySelectorAll('[id^="year-"]');
  const pills = document.querySelectorAll(".year-pill");

  if (yearBlocks.length > 0) {
    const onScroll = () => {
      let currentId: string | null = null;
      yearBlocks.forEach((block) => {
        const rect = block.getBoundingClientRect();
        if (rect.top <= 120) {
          currentId = block.id;
        }
      });
      if (currentId) {
        pills.forEach((pill) => {
          const isActive = pill.getAttribute("href") === `#${currentId}`;
          pill.classList.toggle("is-active", isActive);
        });
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>

---
// src/pages/blog/archive.astro

import { 
  getCollection, 
  type CollectionEntry 
} from 'astro:content';

import { 
  buildMeta, 
  schemaWebPage, 
  schemaBreadcrumb, 
  SITE, 
  ROUTES, 
  IMAGE
} from "@/consts";
import { ARCHIVE_PAGE } from "@/config/pages/archive";

import Layout from '@/layouts/Layout.astro';
import Section from "@/components/ui/Section.astro";
import Container from '@/components/ui/Container.astro';
import Card from '@ui/Card.astro';
import Button from '@ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { formatDate, formatDateCompact } from '@lib/utils';

type BlogEntry = CollectionEntry<'blog'>;

const allPosts: BlogEntry[] = await getCollection('blog', ({ data }) => !data.draft);

const sortedPosts = allPosts.sort((a, b) => {
  const dateA = a.data.pubDate ?? new Date(0);
  const dateB = b.data.pubDate ?? new Date(0);
  return dateB.getTime() - dateA.getTime();
});

const formatMonthName = (monthIndex: number) => {
  return new Intl.DateTimeFormat(ARCHIVE_PAGE.locale, { month: 'long' }).format(new Date(2000, monthIndex, 1));
};

type GroupedArchive = Record<number, Record<number, BlogEntry[]>>;

const archive = sortedPosts.reduce<GroupedArchive>((acc, post) => {
  const date = post.data.pubDate ?? new Date(0);
  const year = date.getFullYear();
  const month = date.getMonth();

  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = [];

  acc[year][month].push(post);
  return acc;
}, {});

const years = Object.keys(archive).map(Number).sort((a, b) => b - a);
const currentYear = new Date().getFullYear();
const activeYear = years.length > 0 ? years[0] : currentYear;

const { colors, months, heatmap, breadcrumb } = ARCHIVE_PAGE;

function getYearActivity(year: number) {
  if (!archive[year]) return [];
  const posts = Object.values(archive[year]).flat();
  const postCounts: Record<string, number> = {};
  
  posts.forEach(post => {
    if (!post.data.pubDate) return;
    const dateStr = post.data.pubDate.toISOString().split('T')[0];
    postCounts[dateStr] = (postCounts[dateStr] || 0) + 1;
  });

  const grid = [];
  let current = new Date(Date.UTC(year, 0, 1));
  const endDate = new Date(Date.UTC(year, 11, 31));

  const startDay = current.getUTCDay();
  const adjustedStart = startDay === 0 ? 6 : startDay - 1;
  for (let i = 0; i < adjustedStart; i++) {
    grid.push({ date: null, count: 0, level: 0 });
  }

  while (current <= endDate) {
    const dateStr = current.toISOString().split('T')[0];
    const count = postCounts[dateStr] || 0;
    
    let level = 0;
    if (count === 1) level = 1;
    else if (count === 2) level = 2;
    else if (count >= 3) level = 3;

    grid.push({ date: dateStr, count, level });
    current.setUTCDate(current.getUTCDate() + 1);
  }
  
  return grid;
}

const activityGrid = getYearActivity(activeYear);
const activeYearTotal = archive[activeYear] ? Object.values(archive[activeYear]).flat().length : 0;
const hasPosts = allPosts.length > 0;

const baseUrl = SITE.url.replace(/\/$/, "");
const canonicalURL = `${baseUrl}${ROUTES.archive}/`;

const { title, description } = ARCHIVE_PAGE;

const breadcrumbItems = [
  { label: breadcrumb.home, href: `${baseUrl}${ROUTES.home}`},
  { label: breadcrumb.blog, href: `${baseUrl}${ROUTES.blog}/` },
  { label: title, href: canonicalURL },
];

const meta = buildMeta({
  title,
  description,
  canonical: canonicalURL,
  ogType: "website",
});

const schema = [
  schemaWebPage({
    title,
    description,
    url: canonicalURL,
    type: "CollectionPage",
    image: {
      url: SITE.logo.startsWith('http') ? SITE.logo : `${baseUrl}${SITE.logo}`,
      width: IMAGE.logo.width,
      height: IMAGE.logo.height,
      caption: title
    }
  }),
  schemaBreadcrumb([
    { name: "Beranda", url: `${baseUrl}/` },
    { name: "Blog", url: `${baseUrl}${ROUTES.blog}/` },
    { name: title, url: canonicalURL },
  ]),
];
---

<Layout {meta} {schema}>
  <main id="main-content" class="w-full min-w-0 flex-1">
    <div class="relative flex w-full flex-1 flex-col items-center pb-(--safe-bottom)">
      
      <Container size="xl">
        <Section
          size="lg"
          class="pt-16 md:pt-24 lg:pt-32 pb-12 md:pb-20 lg:pb-28"
        >
          <div class="grid grid-cols-12 gap-x-6 gap-y-8 lg:gap-y-10">
            <div class="col-span-full lg:col-span-7 flex flex-col gap-4">
              <h1 class="text-heading-32 md:text-heading-48 lg:text-heading-64 text-balance font-medium text-(--fg-strong) max-w-[14ch]">
                {title}
              </h1>
            </div>
            <div class="col-span-full lg:col-span-5 flex flex-col gap-8 lg:py-2">
              <p class="text-body-16 md:text-body-18 text-balance text-(--fg-muted) max-w-[48ch]">
                {description}
              </p>
            </div>
          </div>
        </Section>
      </Container>

      <Container size="xl">
        <Section size="lg" class="py-12 md:py-16 lg:py-24">
          {!hasPosts ? (
            <Card padding="lg" radius="md" variant="outline" class="text-center">
              <p class="text-(--fg-strong) font-medium">{heatmap.emptyLabel}</p>
              <p class="text-sm text-(--fg-muted) mt-1">{heatmap.emptyDescription}</p>
            </Card>
          ) : (
            <>
              <div class="mb-16">
                <Card padding='lg' radius='md' variant='secondary' class="shadow-sm">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
                    <div>
                      <h2 class="text-heading-18 font-semibold text-(--fg-strong) flex items-center gap-2">
                        {heatmap.label} ({activeYear})
                      </h2>
                      <p class="text-sm text-(--fg-muted) mt-1">{heatmap.articlesLabel(activeYearTotal)}</p>
                    </div>
                  </div>
                  
                  <div class="w-full overflow-x-auto pb-4 custom-scrollbar">
                    <div class="min-w-180 flex flex-col gap-2">
                      <div class="flex text-xs font-medium text-(--fg-muted) ml-8 justify-between pr-4">
                        {months.short.map((month) => (
                          <span>{month}</span>
                        ))}
                      </div>

                      <div class="flex gap-3">
                        <div class="grid grid-rows-7 gap-1.5 text-[10px] font-medium text-(--fg-muted) leading-3 pt-0.5">
                          <span class="invisible">Min</span>
                          {ARCHIVE_PAGE.weekdays.short.map((day) => (
                            <span>{day}</span>
                          ))}
                        </div>

                        <div class="inline-grid grid-rows-7 grid-flow-col gap-1.5 flex-1">
                          {activityGrid.map((day, index) => (
                            <div 
                              class={`heatmap-cell size-3 rounded-sm hover:ring-1 hover:ring-(--accent) cursor-default ${day.date ? colors[`level${day.level}` as keyof typeof colors] : 'bg-transparent'}`}
                              title={day.date ? `${day.count} ${heatmap.postsLabel(day.count)} on ${new Date(day.date).toLocaleDateString(ARCHIVE_PAGE.locale, { day: 'numeric', month: 'long', year: 'numeric' })}` : undefined}
                            />
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  <div class="flex items-center justify-end gap-2 mt-4 text-xs font-medium text-(--fg-muted)">
                    <span class="mr-1">{heatmap.legendLow}</span>
                    <div class={`size-3.5 rounded-sm ${colors.level0}`}></div>
                    <div class={`size-3.5 rounded-sm ${colors.level1}`}></div>
                    <div class={`size-3.5 rounded-sm ${colors.level2}`}></div>
                    <div class={`size-3.5 rounded-sm ${colors.level3}`}></div>
                    <span class="ml-1">{heatmap.legendHigh}</span>
                  </div>
                </Card>

                <div class="flex items-center gap-3 mt-6">
                  <span class="text-body-14 font-medium text-(--fg-strong)">{heatmap.jumpLabel}</span>
                  <div class="flex flex-wrap gap-2">
                    {years.map((year) => (
                      <Button
                        href={`#year-${year}`}
                        variant='outline'
                        size='md'
                        data-year-pill={year}
                        class="year-pill"
                      >
                        {year}
                      </Button>
                    ))}
                  </div>
                </div>
              </div>

              <div class="space-y-16">
                {years.map((year) => (
                  <div id={`year-${year}`} class="scroll-mt-(--scroll-padding)">
                    <h2 class="text-heading-24 md:text-heading-32 font-semibold text-(--fg-strong) mb-8 flex items-center gap-4">
                      {year}
                      <span class="h-px flex-1 bg-linear-to-r from-(--border-subtle) to-transparent"></span>
                    </h2>
                    
                    <div class="relative border-l border-(--border) ml-3 md:ml-4 space-y-12 py-2">
                      {Object.keys(archive[year])
                        .map(Number)
                        .sort((a, b) => b - a)
                        .map((month) => (
                          <div class="relative pl-6 md:pl-8">
                            <div class="absolute -left-2 top-1 size-4 bg-(--bg) border-2 border-(--accent) ring-4 ring-(--bg)"></div>
                            
                            <h3 class="flex items-center gap-3 text-label-14 font-semibold text-(--fg-strong) mb-5">
                              {formatMonthName(month)}
                              <Badge variant='accent'>
                                {archive[year][month].length} {heatmap.postsLabel(archive[year][month].length)}
                              </Badge>
                            </h3>
                            
                            <ul class="space-y-2">
                              {archive[year][month].map((post) => {
                                const slug = post.data.slug ?? post.id.replace(/\.(md|mdx)$/, '');
                                const pubDate = post.data.pubDate;
                                return (
                                  <li class="group">
                                    <Card padding='none' radius='sm' variant='primary'>
                                      <a
                                        href={`${baseUrl}${ROUTES.blog}/${slug}/`}
                                        class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-3 py-2 hover:text-(--accent) transition-colors"
                                      >
                                        <span class="text-body-14 font-medium text-(--fg-muted) group-hover:text-(--fg-strong) line-clamp-1">
                                          {post.data.title}
                                        </span>
                                        <div class="flex items-center gap-3 shrink-0">
                                          <time class="text-xs! text-(--fg-muted)/80 bg-(--bg-muted) px-2 py-1 rounded">
                                            {pubDate ? formatDateCompact(pubDate, ARCHIVE_PAGE.locale) : '-'}
                                          </time>
                                        </div>
                                      </a>
                                    </Card>
                                  </li>
                                );
                              })}
                            </ul>
                          </div>
                        ))}
                    </div>
                  </div>
                ))}
              </div>
            </>
          )}
        </Section>
      </Container>
    </div>
  </main>
</Layout>

<style is:global>
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: var(--border-subtle) transparent;
  }
  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: var(--border-subtle);
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: var(--fg-muted);
  }

  .heatmap-cell {
    transition: box-shadow 0.15s ease;
  }

  .year-pill.is-active {
    background-color: var(--accent) !important;
    color: var(--accent-fg) !important;
  }
</style>

<script>
  document.querySelectorAll('.year-pill').forEach((pill) => {
    pill.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = pill.getAttribute('href');
      if (!targetId) return;
      const target = document.querySelector(targetId);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
        document.querySelectorAll('.year-pill').forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
      }
    });
  });

  const yearBlocks = document.querySelectorAll('[id^="year-"]');
  const pills = document.querySelectorAll('.year-pill');

  if (yearBlocks.length > 0) {
    const onScroll = () => {
      let currentId: string | null = null;
      yearBlocks.forEach((block) => {
        const rect = block.getBoundingClientRect();
        if (rect.top <= 120) {
          currentId = block.id;
        }
      });
      if (currentId) {
        pills.forEach((pill) => {
          const isActive = pill.getAttribute('href') === `#${currentId}`;
          pill.classList.toggle('is-active', isActive);
        });
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
---
import { 
  getCollection, 
  render 
} from "astro:content";

import {
  SITE,
  ROUTES,
  IMAGE,
  HOME_PAGE,
  BLOG_PAGE,
  buildMeta,
  schemaArticle,
  schemaBreadcrumb,
} from "@/consts";

import { 
  getSlug, 
  canonicalUrl 
} from "@/lib/utils";

import { components } from "@components/mdx/MDXComponents";

import BlogLayout from "@/layouts/BlogLayout.astro";
import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";

import BlogHeader from "@blog/BlogHeader.astro";
import BlogFooter from "@blog/BlogFooter.astro";

import Toc from "@components/TableOfContent.astro";
import MobileToc from "@docs/mobile/MobileToc.astro";

import RelatedPosts from "@blog/BlogRelated.astro";
import CopyCode from "@components/CopyCode.astro";
import ScrollToTop from "@docs/ScrollToTop.astro";

export async function getStaticPaths() {
  const entries = await getCollection("blog", ({ data }) => !data.draft);

  return entries.map((entry) => {
    const cleanSlug = getSlug(entry);
    return {
      params: {
        slug: cleanSlug,
      },
      props: { entry },
      cacheKey: (entry as any).digest,
    };
  });
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404/");
}

const { Content, headings } = await render(entry);

const allPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      (b.data.pubDate?.getTime() ?? 0) -
      (a.data.pubDate?.getTime() ?? 0),
  );

const currentIndex = allPosts.findIndex((item) => item.id === entry.id);

const prevEntry =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const nextEntry = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const cleanSlug = getSlug(entry);

const currentUrl = canonicalUrl(`${ROUTES.blog}/${cleanSlug}`);

const breadcrumbItems = [
  { label: HOME_PAGE.title, href: canonicalUrl() },
  { label: BLOG_PAGE.title, href: canonicalUrl(ROUTES.blog) }
];

const author = entry.data.author?.name || SITE.name;
const publisher = SITE.name;

const meta = buildMeta({
  title: entry.data.seo.title,
  description: entry.data.seo.description ?? entry.data.description,
  canonical: currentUrl,
  ogImage: entry.data.seo.ogImage,
  ogType: "article",
  datePublished: entry.data.pubDate?.toISOString(),
  dateModified: entry.data.lastUpdated?.toISOString(),
  authorName: author,
  noindex: entry.data.seo.noIndex,
  keywords: entry.data.tags || [],
});

const schema = [
  schemaArticle({
    title: entry.data.title,
    description: entry.data.description || SITE.description,
    url: currentUrl,
    datePublished: entry.data.pubDate?.toISOString(),
    dateModified: entry.data.lastUpdated?.toISOString(),
    authorName: author,
    authorUrl: entry.data.author?.url || SITE.url,
    image: entry.data.cover
      ? {
          url:
            typeof entry.data.cover === "string"
              ? entry.data.cover
              : entry.data.cover.src,
          width: IMAGE.og.width,
          height: IMAGE.og.height,
          caption: entry.data.title,
        }
      : undefined,
  }),
  schemaBreadcrumb([
    { name: HOME_PAGE.title, url: canonicalUrl() },
    { name: BLOG_PAGE.title, url: canonicalUrl(ROUTES.blog) },
    { name: entry.data.title, url: currentUrl },
  ]),
];
---

<BlogLayout
  meta={meta}
  schema={schema}
  author={author}
  publisher={publisher}
>
  <div data-pagefind-weight="3" class="hidden" />
  <MobileToc title={entry.data.title} headings={headings} />
  <Fragment slot="left">
    <div />
  </Fragment>
  <Fragment>
    <div class="mx-auto w-full min-w-0 p-0 lg:p-4 m-2 pb-(--safe-bottom) rounded-xl">
      <Section size="sm">
        <article data-pagefind-body data-pagefind-filter="type:blog">
          <Container size="md">
            <BlogHeader
              title={entry.data.title}
              description={entry.data.description}
              pubDate={entry.data.pubDate}
              content={entry.body}
              breadcrumb={breadcrumbItems}
              cover={entry.data.cover}
              author={entry.data.author}
            />
          </Container>
          <hr class="bg-none border-none border-(--border-subtle)/80 my-6 md:my-8" />
          <Container size="md">
            <div class="prose">
              <Content components={components} />
            </div>
          </Container>
          <hr class="bg-none mt-6 md:mt-8" />
          <Container size="md">         
            <BlogFooter
              tags={entry.data.tags}
              lastUpdated={entry.data.lastUpdated}
              prev={prevEntry}
              next={nextEntry}
            />
          </Container>
        </article>
      </Section>
      <Section size="sm">
        <Container size="md">
          <RelatedPosts
            currentEntry={entry}
            allPosts={allPosts}
            maxItems={3}
          />
        </Container>
      </Section>
    </div>
  </Fragment>
  <Fragment slot="right">
    <Section size="md">
      <div class="sticky top-[calc(--header-height)] right-0 space-y-2">
        <ScrollToTop label="Scroll to top" />
      </div>
      <div class="fixed top-1/2 right-4 z-40 hidden -translate-y-1/2 lg:block">
        <Toc headings={headings} />
      </div>
    </Section>
  </Fragment>
  <CopyCode />
</BlogLayout>
<script>
  import "../../lib/tabs";
</script>

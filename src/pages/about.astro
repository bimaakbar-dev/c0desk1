---
import {
  ABOUT_PAGE,
  SITE,
  ROUTES,
  buildMeta,
  schemaWebPage,
  schemaBreadcrumb,
  IMAGE,
} from "@/consts";

import { canonicalUrl } from "@/lib/utils";

import Layout from "@/layouts/Layout.astro";
import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";
import Button from "@ui/Button.astro";
import Icons from "@ui/Icons.astro";
import Card from "@ui/Card.astro";

const { title, description, hero, features, team, cta } = ABOUT_PAGE;

const currentUrl = canonicalUrl(ROUTES.about);

const meta = buildMeta({
  title,
  description,
  canonical: currentUrl,
  ogType: "website",
  keywords: ["about", "team", "project", "documentation", "template"],
});

const schema = [
  schemaWebPage({
    title,
    description,
    url: currentUrl,
    type: "AboutPage",
    image: {
      url: SITE.logo.startsWith("http")
        ? SITE.logo
        : `${SITE.url.replace(/\/$/, "")}${SITE.logo}`,
      width: 500,
      height: 500,
      caption: title,
    },
  }),
  schemaBreadcrumb([
    { name: "Home", url: canonicalUrl() },
    { name: title, url: currentUrl },
  ]),
];
---

<Layout {meta} {schema}>
  <main id="main-content" class="w-full min-w-0 flex-1">
    <div
      class="relative flex w-full flex-1 flex-col items-center pb-(--safe-bottom)"
    >
      <Container size="xl">
        <Section
          size="lg"
          class="pt-16 pb-12 md:pt-24 md:pb-20 lg:pt-32 lg:pb-28"
        >
          <div class="grid grid-cols-12 gap-x-6 gap-y-8 lg:gap-y-10">
            <div class="col-span-full flex flex-col gap-4 lg:col-span-7">
              <h1
                class="text-heading-32 md:text-heading-48 lg:text-heading-64 max-w-[14ch] font-medium text-balance text-(--fg-strong)"
              >
                {hero.title}
              </h1>
            </div>
            <div
              class="col-span-full flex flex-col gap-8 lg:col-span-5 lg:py-2"
            >
              <p
                class="text-body-16 md:text-body-18 max-w-[48ch] text-balance text-(--fg-muted)"
              >
                {hero.description}
              </p>
              <div class="flex flex-wrap items-start gap-4">
                <Button
                  href={hero.primaryAction.href.startsWith("http")
                    ? hero.primaryAction.href
                    : canonicalUrl(hero.primaryAction.href)}
                  variant="primary"
                  size="lg"
                  suffix={(<Icons name="arrow-right" class="size-4.5" />)}
                >
                  {hero.primaryAction.label}
                </Button>
                <Button
                  href={hero.secondaryAction.href.startsWith("http")
                    ? hero.secondaryAction.href
                    : canonicalUrl(hero.secondaryAction.href)}
                  variant="ghost"
                  size="lg"
                >
                  {hero.secondaryAction.label}
                </Button>
              </div>
            </div>
          </div>
        </Section>
      </Container>
      <Container size="xl">
        <Section size="lg" class="py-12 md:py-16 lg:py-24">
          <div class="mb-12 grid grid-cols-12 gap-x-6 gap-y-6 md:mb-16">
            <h2
              class="text-heading-28 md:text-heading-40 col-span-full font-medium text-balance text-(--fg-strong) md:col-span-8"
            >
              Why This Template?
            </h2>
          </div>
          <ul class="grid list-none grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
            {
              features.map((feature) => (
                <Card padding="md" radius="sm" variant="secondary">
                  <li class="flex flex-col gap-4">
                    <div class="flex items-center gap-3">
                      <span class="flex size-10 items-center justify-center rounded-full bg-(--accent)/10 text-(--accent)">
                        <Icons name={feature.icon} class="size-5" />
                      </span>
                      <span class="text-label-14 font-medium text-(--fg-strong)">
                        {feature.title}
                      </span>
                    </div>
                    <p class="text-body-14 leading-relaxed text-balance text-(--fg-muted)">
                      {feature.description}
                    </p>
                  </li>
                </Card>
              ))
            }
          </ul>
        </Section>
      </Container>
      <Container size="xl">
        <Section size="lg" class="py-12 md:py-16 lg:py-24">
          <div class="mb-12 grid grid-cols-12 gap-x-6 gap-y-6 md:mb-16">
            <h2
              class="text-heading-28 md:text-heading-40 col-span-full font-medium text-(--fg-strong)"
            >
              {team.title}
            </h2>
            <p
              class="text-body-16 col-span-full text-balance text-(--fg-muted) md:col-span-8"
            >
              {team.description}
            </p>
          </div>
          <ul
            class="grid list-none grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
          >
            {
              team.members.map((member) => (
                <li class="flex flex-col items-center gap-4 text-center">
                  <a
                    href={member.social}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative block"
                  >
                    <span class="block size-24 overflow-hidden rounded-full border-2 border-(--border-subtle)/60 grayscale transition-colors group-hover:border-(--accent) group-hover:grayscale-0">
                      <img
                        src={member.avatar}
                        alt={member.name}
                        width={IMAGE.avatar.width}
                        height={IMAGE.avatar.height}
                        loading="lazy"
                        decoding="async"
                        fetchpriority="high"
                        class="size-full object-cover"
                      />
                    </span>
                  </a>
                  <div>
                    <h3 class="text-heading-18 font-medium text-(--fg-strong)">
                      {member.name}
                    </h3>
                    <p class="text-body-14 mt-0.5 text-(--fg-muted)">
                      {member.role}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </Section>
      </Container>
      <Container size="xl">
        <Section size="lg" class="py-12 md:py-16 lg:py-24">
          <div class="grid grid-cols-12 gap-x-6 gap-y-6">
            <div
              class="col-span-full flex flex-col items-center justify-center gap-8 md:gap-10 lg:flex-row lg:gap-12"
            >
              <h2
                class="text-heading-28 md:text-heading-40 lg:text-heading-48 max-w-[16ch] text-center font-medium text-balance text-(--fg-strong) lg:text-left"
              >
                {cta.title}
              </h2>
              <div class="flex flex-wrap items-center justify-center gap-4">
                <Button
                  href={cta.primaryAction.href.startsWith("http")
                    ? cta.primaryAction.href
                    : canonicalUrl(cta.primaryAction.href)}
                  variant="primary"
                  size="lg"
                  suffix={(<Icons name="arrow-right" class="size-4.5" />)}
                >
                  {cta.primaryAction.label}
                </Button>
                <Button
                  href={cta.secondaryAction.href.startsWith("http")
                    ? cta.secondaryAction.href
                    : canonicalUrl(cta.secondaryAction.href)}
                  variant="ghost"
                  size="lg"
                >
                  {cta.secondaryAction.label}
                </Button>
              </div>
            </div>
          </div>
        </Section>
      </Container>
    </div>
  </main>
</Layout>

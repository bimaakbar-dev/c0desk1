---
// src/pages/docs/index.astro
import { getCollection } from "astro:content";
import {
  SITE,
  ROUTES,
  buildMeta,
  SIDEBAR_CONFIG,
  schemaWebPage,
  schemaBreadcrumb,
} from "@/consts";

import { getSlug } from "@/lib/utils";

import Layout from "@/layouts/Layout.astro";
import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";
import Icon from "@ui/Icons.astro";
import DocsHero from "@docs/DocsHero.astro";

// ===== Data Docs =====
const allDocs = await getCollection("docs", ({ data }) => !data.draft);
const sortedDocs = [...allDocs].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const docsByCategory = Object.groupBy(
  sortedDocs,
  (doc) => doc.data.category ?? "Uncategorized"
) as Partial<Record<string, typeof allDocs>>;

const firstCategoryConfig = SIDEBAR_CONFIG[0];
let startReadingDoc = null;

if (firstCategoryConfig) {
  const categoryKey = firstCategoryConfig.category;
  const categoryDocs = docsByCategory[categoryKey] || [];
  if (categoryDocs.length > 0) {
    const sortedCategoryDocs = [...categoryDocs].sort(
      (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
    );
    startReadingDoc = sortedCategoryDocs[0];
  }
}

if (!startReadingDoc) {
  startReadingDoc = sortedDocs[0];
}

// ===== Helper =====
const docUrl = (doc: any) => `${ROUTES.docs}/${getSlug(doc)}/`;
const startReadingHref = startReadingDoc ? docUrl(startReadingDoc) : `${ROUTES.docs}/`;

// ===== Meta =====
const meta = buildMeta({
  title: "Documentation",
  description: "Explore our guides, component references, and Integration documentation.",
  canonical: `${SITE.url}${ROUTES.docs}/`,
  ogType: "website",
});

// ===== Schema =====
const schema = [
  schemaWebPage({
    title: "Documentation",
    description: "Explore our guides, component references, and Integration documentation.",
    url: `${SITE.url}${ROUTES.docs}/`,
    type: "CollectionPage",
  }),
  schemaBreadcrumb([
    { name: "Home", url: SITE.url },
    { name: "Documentation", url: `${SITE.url}${ROUTES.docs}/` },
  ]),
];

// ===== Styles =====
const $ = {
  card: [
    "group flex flex-col gap-3 p-6 rounded-xl ring-1 ring-(--border)",
    "bg-(--bg-muted)/50 hover:bg-(--bg-muted) no-underline",
  ].join(" "),
  cardTitle: "text-title-20 font-semibold text-(--fg-strong)",
  cardDesc: "text-body-14 text-(--fg-muted)",
  linkList: "mt-4 space-y-2",
  linkItem:
    "flex items-center gap-2 text-label-14 text-(--fg-muted) hover:text-(--fg-strong)",
};
---

<Layout meta={meta} schema={schema}>
  <main id="main-content" class="w-full min-w-0 flex-1">
      <div class="relative flex w-full flex-1 flex-col items-center pb-(--safe-bottom)">
        <DocsHero
          title="Welcome to My Docs"
          description="Everything you need to know about my project."
          primaryText="Start Here"
          primaryHref={startReadingHref}
          secondaryText="Read Blog"
          secondaryHref={ROUTES.blog}
        />
        <Section size="md" class="py-12 lg:py-16">
          <Container size="xl">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        	  {SIDEBAR_CONFIG.map((config) => {
                const categoryDocs = docsByCategory[config.category] ?? [];
                if (categoryDocs.length === 0) return null;

                const firstDoc = categoryDocs[0];
                const mainHref = docUrl(firstDoc);

                return (
                  <div class={$.card}>
                    <h2 class={$.cardTitle}>{config.label}</h2>
                    <p class={$.cardDesc}>
                      Explore {categoryDocs.length} articles in {config.label.toLowerCase()}.
                  </p>

                  <div class={$.linkList}>
                    {categoryDocs.slice(0, 3).map((doc) => (
                      <a href={docUrl(doc)} aria-label="view-document" class={$.linkItem}>
                        <Icon name="file-text" class="size-4 shrink-0" />
                        <span class="truncate">{doc.data.title}</span>
                      </a>
                    ))}
                  </div>

                  <a
                    href={mainHref}
                    aria-label="view-all"
                    class="mt-auto mt-4 text-label-14 font-medium flex items-center gap-1"
                  >
                  View all <Icon name="arrow-right" class="size-4" />
                  </a>
                </div>
              );
            })}
          </div>
        </Container>
      </Section>
    </div>
  </main>
</Layout>
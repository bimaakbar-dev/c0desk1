---
import { 
  getCollection, 
  render 
} from "astro:content";

import {
  SITE,
  ROUTES,
  IMAGE,
  SIDEBAR_CONFIG,
  DOCS_PAGE,
  buildMeta,
  schemaWebPage,
  schemaBreadcrumb 
} from "@/consts";

import { 
  getSlug, 
  canonicalUrl 
} from "@/lib/utils";

import { components } from "@components/mdx/MDXComponents";

import DocsLayout from "@/layouts/DocsLayout.astro";
import Container from "@ui/Container.astro";
import Section from "@ui/Section.astro";
import MobileToc from "@docs/mobile/MobileToc.astro";
import DocsHeader from "@docs/DocsHeader.astro";
import DocsFooter from "@docs/DocsFooter.astro";
import Toc from "@components/TableOfContent.astro";
import CopyCode from "@/components/CopyCode.astro";
import ScrollToTop from "@docs/ScrollToTop.astro";

export async function getStaticPaths() {
  const docsEntries = await getCollection("docs", ({ data }) => !data.draft);

  return docsEntries.map((entry) => {
    const cleanSlug = getSlug(entry);
    return {
      params: { slug: cleanSlug },
      props: { entry },
      cacheKey: (entry as any).digest,
    };
  });
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404/");
}

const { Content, headings } = await render(entry);

const allDocs = await getCollection("docs", ({ data }) => !data.draft);
const sortedDocs = [...allDocs].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const docsByCategory = Object.groupBy(
  sortedDocs,
  (doc) => doc.data.category ?? "Uncategorized",
) as Partial<Record<string, typeof allDocs>>;

const configCategories = SIDEBAR_CONFIG.map((c) => c.category);
const availableCategories = Object.keys(docsByCategory);

const sortedCategories = [
  ...configCategories.filter((cat) => cat in docsByCategory),
  ...availableCategories.filter((cat) => !configCategories.includes(cat as any)),
];

const ungroupedDocs = sortedDocs.filter((doc) => !doc.data.category);

const orderedPaginationItems = [
  ...sortedCategories.flatMap((cat) => docsByCategory[cat] ?? []),
  ...ungroupedDocs,
];

const currentIndex = orderedPaginationItems.findIndex((item) => item.id === entry.id);
const prevEntry = currentIndex > 0 ? orderedPaginationItems[currentIndex - 1] : null;
const nextEntry =
  currentIndex < orderedPaginationItems.length - 1
    ? orderedPaginationItems[currentIndex + 1]
    : null;

const cleanSlug = getSlug(entry);

const currentUrl = canonicalUrl(`${ROUTES.docs}/${cleanSlug}`);

const docsImage = entry.data.seo?.ogImage || SITE.logo;
const absoluteDocsImage = docsImage.startsWith("http")
  ? docsImage
  : `${SITE.url.replace(/\/$/, "")}${docsImage}`;

const author = entry.data.author?.name || SITE.name;
const publisher = SITE.name;

const meta = buildMeta({
  title: entry.data.seo.title,
  description: entry.data.seo.description ?? entry.data.description,
  canonical: currentUrl,
  ogImage: entry.data.seo.ogImage,
  ogType: "article",
  datePublished: entry.data.pubDate?.toISOString(),
  dateModified: entry.data.lastUpdated?.toISOString(),
  authorName: author,
  noindex: entry.data.seo.noIndex,
});

const schema = [
  schemaWebPage({
    title: entry.data.title,
    description: entry.data.description || SITE.description,
    url: currentUrl,
    image: {
      url: absoluteDocsImage,
      width: IMAGE.og.width,
      height: IMAGE.og.height,
      caption: entry.data.title,
    },
  }),
  schemaBreadcrumb([
    { name: "Home", url: canonicalUrl() },
    { name: DOCS_PAGE.title, url: canonicalUrl(ROUTES.docs) },
    { name: entry.data.title, url: currentUrl },
  ]),
];

const fullMarkdownContent = `
# ${entry.data.title}

${entry.body}`;
---

<DocsLayout
  meta={meta}
  schema={schema}
  author={author}
  publisher={publisher}
>
  <MobileToc title={entry.data.title} headings={headings} />

  <Fragment>
    <div class="mx-auto w-full min-w-0">
      <Section size="md">
        <article data-pagefind-body data-pagefind-filter="type:docs">
          <Container size="lg">
            <DocsHeader
              title={entry.data.title}
              description={entry.data.description}
              content={fullMarkdownContent}
            />
          </Container>
          
          <hr/>
          
          <Container size="lg">
            <div class="prose">
              <Content components={components} />
            </div>
          </Container>
          
          <hr/>
          
          <Container size="lg">
            <DocsFooter
              lastUpdated={entry.data.lastUpdated}
              prev={prevEntry}
              next={nextEntry}
            />
          </Container>
        </article>
      </Section>
    </div>
  </Fragment>

  <Fragment slot="right">
    <div class="fixed top-1/2 right-4 z-40 hidden -translate-y-1/2 lg:block">
      <Toc headings={headings} />
    </div>
    <div class="flex flex-col justify-between min-h-full">
      <div class="space-y-4"></div>
      <div class="pt-4 mt-auto">
        <ScrollToTop label="Scroll to top" class="text-(--fg-muted)" />
      </div>
    </div>
  </Fragment>
</DocsLayout>

<script>
  import "../../lib/tabs";
  import "../../lib/copy-code";
</script>
